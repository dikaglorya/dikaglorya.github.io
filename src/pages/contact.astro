---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/content.css';
import { services } from '../data/services';
import { site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Kontak ObitoGlory',
  url: `${site.url}/contact/`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.personName,
    alternateName: site.alternateNames,
    url: site.url,
    email: `mailto:${site.email}`,
    sameAs: [site.github, site.telegramUrl, site.instagram, site.tiktok],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Jawa Tengah',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title="Kontak DikaOfc | DikaGlorya | ObitoGlory"
  description="Hubungi DikaGlorya (DikaOfc, DikaCode), programmer dari Kendal, untuk jasa website, bot, tools, dan perbaikan sistem."
  schema={schema}
>
  <section class="page-hero" aria-labelledby="contact-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Kontak · DikaOfc</p>
      <h1 id="contact-title">Mari bahas proyekmu.</h1>
      <p class="page-hero__lead">
        Untuk pertanyaan proyek, kolaborasi, atau diskusi teknis. Belum harus langsung berkomitmen,
        kita bisa ngobrol dulu.
      </p>
      <div class="page-hero__meta mono">
        <span class="status">{site.availability}</span>
        <span>{site.location}</span>
        <span>Telegram paling cepat</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-label="Cara menghubungi" data-reveal>
    <div class="container contact-layout">
      <div class="contact-form-wrap">
        <h2>Brief proyek</h2>
        <p>
          Nama, email, layanan, dan pesan wajib diisi. Tombol menyiapkan brief berformat HTML dan
          menyalinnya, lalu kamu tempel di Gmail. Website ini tidak mengirim data ke server.
        </p>

        <form
          class="contact-form"
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
          novalidate
          data-contact-form
          data-contact-email={site.email}
          data-site-name={site.name}
          data-site-location={site.location}
        >
          <div class="form-row">
            <div class="form-field">
              <label for="name">
                Nama <span class="required-mark" aria-hidden="true">*</span>
              </label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="email">
                Email <span class="required-mark" aria-hidden="true">*</span>
              </label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="service">
                Layanan <span class="required-mark" aria-hidden="true">*</span>
              </label>
              <select id="service" name="service" required>
                <option value="">Pilih layanan</option>
                {services.map((service) => (
                  <option value={service.slug}>{service.name}</option>
                ))}
                <option value="other">Lainnya, belum yakin</option>
              </select>
            </div>
            <div class="form-field">
              <label for="budget">Anggaran</label>
              <select id="budget" name="budget">
                <option value="Belum ditentukan">Belum ditentukan</option>
                <option value="Di bawah Rp500k">Di bawah Rp500k</option>
                <option value="Rp500k sampai Rp1jt">Rp500k sampai Rp1jt</option>
                <option value="Rp1jt sampai Rp3jt">Rp1jt sampai Rp3jt</option>
                <option value="Di atas Rp3jt">Di atas Rp3jt</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="message">
              Kebutuhanmu <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Contoh: landing page untuk jasa servis AC, domain sudah siap, target rilis bulan depan."
              required
            ></textarea>
          </div>

          <button class="btn btn--primary" type="submit">Siapkan brief email</button>

          <p class="form-note">
            Brief disalin ke clipboard, bukan dikirim. Di Gmail, tempel dengan Ctrl+V (Windows)
            atau Cmd+V (Mac). Kalau clipboard diblokir, pakai tautan aplikasi email yang berisi
            versi teks biasa.
          </p>

          <p class="form-status" role="status" aria-live="polite" data-form-status></p>

          <div class="brief-ready" data-brief-ready hidden>
            <h3 tabindex="-1" data-brief-ready-title>Brief siap</h3>
            <p
              class="brief-ready__status"
              role="status"
              aria-live="polite"
              data-brief-copy-status
            ></p>
            <div class="brief-ready__actions">
              <a
                class="btn btn--primary"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                data-brief-gmail
              >
                Buka Gmail
              </a>
              <button class="btn" type="button" data-brief-copy>Salin ulang</button>
              <a class="btn btn--small" href="#" data-brief-mailto>Aplikasi email lain</a>
            </div>
            <p class="form-note">
              Gmail terbuka dengan penerima dan subjek yang sudah terisi. Badan email masih kosong,
              jadi tempel brief di sana sebelum mengirim.
            </p>
          </div>
        </form>
      </div>

      <aside class="contact-aside" aria-label="Kontak langsung">
        <h2>Kontak langsung</h2>
        <ul class="channel-list">
          <li>
            <a class="channel-list__row" href={site.telegramUrl} rel="me">
              <span class="channel-list__name">Telegram</span>
              <span class="channel-list__handle">@{site.telegram}</span>
            </a>
          </li>
          <li>
            <a class="channel-list__row" href={`mailto:${site.email}`}>
              <span class="channel-list__name">Email</span>
              <span class="channel-list__handle">{site.email}</span>
            </a>
          </li>
          <li>
            <a class="channel-list__row" href={site.github} rel="me noopener noreferrer" target="_blank">
              <span class="channel-list__name">GitHub</span>
              <span class="channel-list__handle">@{site.githubHandle}</span>
            </a>
          </li>
          <li>
            <a class="channel-list__row" href={site.instagram} rel="me noopener noreferrer" target="_blank">
              <span class="channel-list__name">Instagram</span>
              <span class="channel-list__handle">@xxcdicka</span>
            </a>
          </li>
        </ul>

        <button
          class="btn btn--small"
          type="button"
          data-copy-email={site.email}
        >
          Salin email
        </button>
        <p class="form-note" role="status" aria-live="polite" data-copy-status></p>

        <div class="next-steps">
          <h3>Setelah dikirim</h3>
          <ol>
            <li>
              <div>
                <strong>Brief dibaca.</strong>
                <span>Biasanya dibalas lewat Telegram atau email.</span>
              </div>
            </li>
            <li>
              <div>
                <strong>Lingkup diperjelas.</strong>
                <span>Fitur, platform, revisi, dan batasan dibahas terlebih dulu.</span>
              </div>
            </li>
            <li>
              <div>
                <strong>Penawaran dikirim.</strong>
                <span>Harga, timeline, dan alur kerja dijelaskan dengan jelas.</span>
              </div>
            </li>
            <li>
              <div>
                <strong>Proyek dimulai setelah sepakat.</strong>
                <span>DP 50% untuk mulai, sisanya setelah hasil diserahkan dan disetujui.</span>
              </div>
            </li>
          </ol>
        </div>

        <p class="mono muted">
          {site.location}
        </p>
      </aside>
    </div>
  </section>

  <script>
    import '../scripts/contact';
  </script>
</BaseLayout>
