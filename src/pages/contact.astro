---
import BaseLayout from '../layouts/BaseLayout.astro';
import BilingualCopy from '../components/BilingualCopy.astro';
import { services } from '../data/services';
import { site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact ObitoGlory',
  url: `${site.url}/contact/`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.personName,
    alternateName: site.alternateNames,
    url: site.url,
    email: `mailto:${site.email}`,
    sameAs: [site.github],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Central Java',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title="Contact / Kontak DikaOfc | DikaGlorya | ObitoGlory"
  description="Hubungi DikaGlorya (DikaOfc / DikaCode), programmer dari Kendal, untuk jasa website, bot, tools, dan perbaikan sistem / Contact DikaGlorya for website, bot, developer tool, or system repair projects."
  schema={schema}
>
  <section class="page-hero page-hero--contact" aria-labelledby="contact-title">
    <div class="container">
      <h1 id="contact-title">Let's talk about the work. / Mari bahas proyekmu.</h1>
      <BilingualCopy
        class="page-hero__lead"
        en="For project inquiries, collaboration, or technical discussions. You do not need to commit yet; an open discussion is welcome."
        id="Untuk pertanyaan proyek, kolaborasi, atau diskusi teknis. Belum harus langsung berkomitmen—kita bisa ngobrol dulu."
      />
      <div class="page-hero__meta mono">
        <span class="status">{site.availability}</span>
        <span>{site.location}</span>
        <span>Telegram is fastest</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-label="Contact methods">
    <div class="container contact-layout">
      <div class="contact-form-wrap">
        <h2>Project brief / Brief proyek</h2>
        <BilingualCopy
          en="Name, email, service, and message are required. The button opens your email app with the brief filled in; this site does not send it to a server."
          id="Nama, email, layanan, dan pesan wajib diisi. Tombol akan membuka aplikasi email dengan brief terisi; website ini tidak mengirim data ke server."
        />

        <form
          class="contact-form"
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
          novalidate
          data-contact-form
          data-contact-email={site.email}
        >
          <div class="form-row">
            <div class="form-field">
              <label for="name">
                Name / Nama <span class="required-mark" aria-hidden="true">*</span>
              </label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="email">
                Email <span class="required-mark" aria-hidden="true">*</span>
              </label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="service">
                Service / Layanan <span class="required-mark" aria-hidden="true">*</span>
              </label>
              <select id="service" name="service" required>
                <option value="">Choose a service / Pilih layanan</option>
                {services.map((service) => (
                  <option value={service.slug}>{service.name}</option>
                ))}
                <option value="other">Something else / Lainnya / not sure yet</option>
              </select>
            </div>
            <div class="form-field">
              <label for="budget">Budget / Anggaran</label>
              <select id="budget" name="budget">
                <option value="Not decided yet">Not decided yet</option>
                <option value="Under Rp500k">Under Rp500k</option>
                <option value="Rp500k to Rp1m">Rp500k to Rp1m</option>
                <option value="Rp1m to Rp3m">Rp1m to Rp3m</option>
                <option value="Above Rp3m">Above Rp3m</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="message">
              What you need / Kebutuhanmu <span class="required-mark" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Contoh / Example: landing page untuk jasa servis AC, domain sudah siap, target rilis bulan depan."
              required
            ></textarea>
          </div>

          <button class="btn btn--primary" type="submit">Open email brief / Buka brief di email</button>

          <p class="form-note">
            Form ini menggunakan <span class="mono">mailto:</span> dan membuka aplikasi email.
            / This form uses <span class="mono">mailto:</span> and opens your email app.
            Jika tidak terbuka / If nothing opens, email langsung / email directly:
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.
          </p>

          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </form>
      </div>

      <aside class="contact-aside" aria-label="Direct contact">
        <h2>Direct channels / Kontak langsung</h2>
        <ul class="channel-list">
          <li>
            <a href={site.telegramUrl} rel="me">Telegram</a>
            <span>@{site.telegram}</span>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>Email</a>
            <span>{site.email}</span>
          </li>
          <li>
            <a href={site.github} rel="me noopener noreferrer" target="_blank">GitHub</a>
            <span>@{site.githubHandle}</span>
          </li>
          <li>
            <a href={site.instagram} rel="me noopener noreferrer" target="_blank">Instagram</a>
            <span>@xxcdicka</span>
          </li>
        </ul>

        <button
          class="btn btn--small"
          type="button"
          data-copy-email={site.email}
        >
          Copy email / Salin email
        </button>
        <p class="form-note" role="status" aria-live="polite" data-copy-status></p>

        <div class="next-steps">
          <h3>After you send it / Setelah dikirim</h3>
          <ol>
            <li>
              <div>
                <strong>Brief dibaca / The brief gets read.</strong>
                <span>Biasanya dibalas lewat Telegram atau email / Usually answered through Telegram or email.</span>
              </div>
            </li>
            <li>
              <div>
                <strong>Lingkup diperjelas / Scope gets clarified.</strong>
                <span>Fitur, platform, revisi, dan batasan dibahas terlebih dulu / Features, platform, revisions, and limits are discussed first.</span>
              </div>
            </li>
            <li>
              <div>
                <strong>Penawaran dikirim / A quote comes back.</strong>
                <span>Harga, timeline, dan alur kerja dijelaskan dengan jelas / Price, timeline, and workflow are written out clearly.</span>
              </div>
            </li>
            <li>
              <div>
                <strong>Proyek dimulai setelah sepakat / The project starts once agreed.</strong>
                <span>DP 50% untuk mulai, sisanya setelah hasil diserahkan dan disetujui / 50% deposit to begin, the rest after delivery and approval.</span>
              </div>
            </li>
          </ol>
        </div>

        <p class="mono muted">
          {site.location}
        </p>
      </aside>
    </div>
  </section>

  <script>
    import '../scripts/contact';
  </script>
</BaseLayout>
