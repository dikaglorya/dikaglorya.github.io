---
import ContactBlock from '../components/ContactBlock.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import ProjectRow from '../components/ProjectRow.astro';
import RouteDiagram from '../components/RouteDiagram.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import Arrow from '../components/Arrow.astro';
import { facts } from '../data/facts';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { technologyGroups } from '../data/technologies';
import { articles } from '../data/articles';

const featured = projects.find((project) => project.slug === 'dikaroute');
const selected = projects.filter((project) => project.slug !== 'dikaroute').slice(0, 4);

const capabilities = [
  {
    title: 'Website',
    body: 'Website responsif dan aplikasi web kecil dengan struktur jelas, diuji sebelum diserahkan.',
  },
  {
    title: 'Bot dan integrasi',
    body: 'Otomasi alur kerja dan integrasi Telegram, WhatsApp, serta Discord.',
  },
  {
    title: 'Tools developer',
    body: 'Utilitas, skrip, dan eksperimen untuk membantu workflow developer, termasuk AI agent lokal.',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'ObitoGlory',
  url: site.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.personName,
    alternateName: site.alternateNames,
    url: site.url,
    image: new URL(site.profileImage, site.url).href,
    jobTitle: 'Developer independen',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Jawa Tengah',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title={site.title}
  description={site.description}
  schema={homeSchema}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__body">
        <p class="hero__pill">
          <span class="status">{site.availability}</span>
        </p>

        <h1 class="hero__title" id="hero-title">Dibuat untuk <em>dipakai.</em></h1>

        <p class="hero__lead">
          Website, bot, dan developer tools dari <strong>Kendal, Indonesia</strong>. Dikerjakan
          oleh DikaGlorya — dikenal juga sebagai DikaOfc dan DikaCode.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="/projects/">Lihat proyek <Arrow /></a>
          <a class="btn" href="/contact/">Mulai percakapan</a>
        </div>
      </div>

      <div class="hero__stage">
        <PortraitFrame
          class="hero__portrait"
          sizes="(max-width: 900px) 78vw, 360px"
          caption="DikaGlorya"
          index="Kendal, ID"
          priority
        />
        <div class="hero__chip">
          <span class="status" aria-hidden="true"></span>
          <span>
            <strong>Developer independen</strong>
            Kendal, Jawa Tengah · WIB
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="identity-strip" role="list" aria-label="Bidang kerja">
    <div class="container identity-strip__row mono">
      <span role="listitem">Pengembangan web</span>
      <span role="listitem">Bot dan automasi</span>
      <span role="listitem">Tools developer</span>
      <span role="listitem">AI dan keamanan</span>
    </div>
  </div>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHead
        id="work-title"
        index="01 / Selected work"
        title="Proyek pilihan"
        meta="Proyek, eksperimen, dan tools yang dijelaskan lewat keputusan teknisnya."
        link={{ href: '/projects/', label: 'Semua proyek' }}
      />

      {featured && (
        <article class="featured" data-reveal>
          <div class="featured__copy">
            <p class="featured__label mono">
              Studi kasus · source belum publik · {featured.type}
            </p>
            <h3>{featured.name}</h3>
            <p>{featured.summary}</p>
            <p class="mono">{featured.stack.join(' · ')}</p>
            <a class="link" href={`/projects/${featured.slug}/`}>
              Baca studi kasus <Arrow />
            </a>
          </div>
          <figure class="featured__diagram">
            <RouteDiagram />
            <figcaption class="mono">
              Ilustrasi alur request dan pemilihan provider; bukan status koneksi langsung.
            </figcaption>
          </figure>
        </article>
      )}

      <div class="project-list">
        {selected.map((project, index) => (
          <div data-reveal>
            <ProjectRow project={project} index={index + 2} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="about-title">
    <div class="container about-grid">
      <PortraitFrame
        class="about-portrait"
        sizes="(max-width: 900px) 100vw, 42vw"
        caption="DikaGlorya, developer"
        index="Portrait / 01"
      />

      <div class="about-grid__body">
        <h2 id="about-title">Lebih sedikit noise, software lebih baik.</h2>
        <p>
          Saya DikaGlorya, developer independen dari Kendal. DikaCode adalah identitas untuk karya
          software; ObitoGlory adalah rumah untuk proyek, catatan teknis, dan cara saya bekerja.
        </p>
        <p>
          Setiap hal dibuat untuk kebutuhan nyata, bukan sekadar demo. Struktur dibuat mudah
          dipahami dan dirawat; perbaikan dimulai dengan memahami alurnya.
        </p>

        <dl class="about-facts">
          {facts.map((fact) => (
            <div>
              <dt class="fact__label mono">{fact.label}</dt>
              <dd class="fact__value">{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="about-actions">
          <a class="btn" href="/about/">
            Tentang DikaGlorya <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="capabilities-title">
    <div class="container">
      <SectionHead
        id="capabilities-title"
        index="02 / Capabilities"
        title="Yang saya buat"
        meta="Tiga area utama, dikerjakan dari sketsa sampai serah terima."
      />

      <div class="capability-grid">
        {capabilities.map((capability, index) => (
          <article class="capability" data-reveal>
            <p class="capability__index mono" aria-hidden="true">{`0${index + 1}`}</p>
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))}
      </div>

      <p class="capability-more mono">
        <a class="link" href="/services/">Detail layanan <Arrow /></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="journal-title">
    <div class="container">
      <SectionHead
        id="journal-title"
        index="03 / Journal"
        title="Catatan teknis"
        meta="Detail implementasi dan pelajaran dari prosesnya."
        link={{ href: '/journal/', label: 'Semua catatan' }}
      />
      <div class="journal-list">
        {articles.slice(0, 2).map((article) => (
          <article class="journal-card" data-reveal>
            <p class="mono journal-card__meta">
              <time datetime={article.date}>{article.date}</time> · {article.readingTime} menit baca
            </p>
            <h3>
              <a href={`/journal/${article.slug}/`}>{article.title}</a>
            </h3>
            <p>{article.description}</p>
            <a class="link" href={`/journal/${article.slug}/`}>Baca catatan <Arrow /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stack-title">
    <div class="container">
      <SectionHead
        id="stack-title"
        index="04 / Toolkit"
        title="Teknologi"
        meta="Tools dikelompokkan berdasarkan penggunaan nyata, bukan skor kemampuan."
      />
      <div class="stack-grid">
        {technologyGroups.map((group) => (
          <div class="stack-group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock id="home-contact-title" title="Ada yang ingin dibuat?" />
</BaseLayout>
