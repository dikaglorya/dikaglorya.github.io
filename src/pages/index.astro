---
import ContactBlock from '../components/ContactBlock.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import ProjectRow from '../components/ProjectRow.astro';
import RouteDiagram from '../components/RouteDiagram.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { facts } from '../data/facts';
import { projects } from '../data/projects';
import { site, socialLinks } from '../data/site';
import { currentFocus, technologyGroups } from '../data/technologies';
import { articles } from '../data/articles';

const featured = projects.find((project) => project.slug === 'dikaroute');
const selected = projects.filter((project) => project.slug !== 'dikaroute').slice(0, 5);

const capabilities = [
  {
    title: 'Websites',
    body: 'Responsive interfaces and small web applications, built on a clear structure and tested before delivery.',
  },
  {
    title: 'Bots and integrations',
    body: 'Automated workflows and platform integrations for Telegram, WhatsApp, and Discord.',
  },
  {
    title: 'Developer tools',
    body: 'Utilities, scripts, and experiments that improve development workflows, including AI agents that run locally.',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'ObitoGlory',
  url: site.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.personName,
    alternateName: site.alternateNames,
    url: site.url,
    image: new URL(site.profileImage, site.url).href,
    jobTitle: 'Independent developer',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Central Java',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title={site.title}
  description={site.description}
  schema={homeSchema}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__grid">
        <PortraitFrame
          class="hero__portrait"
          sizes="(max-width: 1120px) 320px, 420px"
          caption="DikaGlorya / developer"
          index="ObitoGlory"
          priority
        />
        <div class="hero__body">
          <p class="hero__eyebrow mono">Independent developer / Kendal, Indonesia</p>
          <h1 class="hero__title" id="hero-title">
            <span class="line"><span>DikaGlorya<span class="hero__stop">.</span></span></span>
            <span class="line"><span>ObitoGlory.</span></span>
          </h1>
          <p class="hero__copy">
            I'm DikaGlorya, also known as DikaCode. ObitoGlory is my home for practical software,
            developer tools, web projects, and technical experiments.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/projects/">See all projects</a>
            <a class="btn" href="/about/">About the identity</a>
          </div>
          <div class="hero__meta mono">
            <span>{site.location}</span>
            <span>{site.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="identity-strip" role="list" aria-label="Work areas">
    <div class="container identity-strip__row mono">
      <span role="listitem">Web development</span>
      <span role="listitem">Bots &amp; automation</span>
      <span role="listitem">Developer tools</span>
      <span role="listitem">AI &amp; security</span>
    </div>
  </div>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHead
        id="work-title"
        title="Selected work"
        meta="Projects, experiments, and tools."
        link={{ href: '/projects/', label: 'All projects' }}
      />

      {featured && (
        <article class="featured">
          <div class="featured__copy">
            <p class="featured__label mono">Case study / source not public / {featured.type}</p>
            <h3>{featured.name}</h3>
            <p>{featured.summary}</p>
            <p class="mono">{featured.stack.join(' / ')}</p>
            <a class="link" href={`/projects/${featured.slug}/`}>Read the case study</a>
          </div>
          <figure class="featured__diagram">
            <RouteDiagram />
            <figcaption class="mono">
              Conceptual diagram: one request enters, DikaRoute picks an available provider and
              falls back automatically.
            </figcaption>
          </figure>
        </article>
      )}

      <div class="project-list">
        {selected.map((project, index) => (
          <ProjectRow project={project} index={index + 2} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="focus-title">
    <div class="container">
      <SectionHead
        id="focus-title"
        title="Current focus"
        meta="Topics being explored; these are not claims of released products."
      />
      <ul class="focus-list">
        {currentFocus.map((item, index) => (
          <li>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="journal-title">
    <div class="container">
      <SectionHead
        id="journal-title"
        title="Technical notes"
        meta="Implementation details and lessons from the work."
        link={{ href: '/journal/', label: 'All notes' }}
      />
      <div class="journal-list">
        {articles.slice(0, 2).map((article) => (
          <article class="journal-card">
            <p class="mono journal-card__meta">
              {article.date} / {article.readingTime} min read
            </p>
            <h3><a href={`/journal/${article.slug}/`}>{article.title}</a></h3>
            <p>{article.description}</p>
            <a class="link" href={`/journal/${article.slug}/`}>Read the note</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="capabilities-title">
    <div class="container">
      <SectionHead
        id="capabilities-title"
        title="What I build"
        meta="The three groups behind the services. Full detail lives on the services page."
      />

      <div class="capability-grid">
        {capabilities.map((capability, index) => (
          <article class="capability">
            <p class="capability__index mono" aria-hidden="true">{`0${index + 1}`}</p>
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))}
      </div>

      <p class="capability-more mono">
        <a class="link" href="/services/">Full detail on the services page</a>
      </p>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="philosophy-title">
    <div class="container container--narrow">
      <h2 class="philosophy-title" id="philosophy-title">Less noise. Better software.</h2>
      <p class="philosophy-body">
        Things here get built for a real use, not for a demo. Systems stay understandable so
        they can be maintained, and fixes start by reading the flow before changing it.
      </p>
      <p class="philosophy-body">
        Code is written from scratch, tested until it works, and handed over with the scope
        agreed in advance. Performance and deliberate design matter more than decorative
        effects.
      </p>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="stack-title">
    <div class="container">
      <SectionHead
        id="stack-title"
        title="Technology index"
        meta="What gets used, grouped by real usage. No proficiency scores."
      />
      <div class="stack-grid">
        {technologyGroups.map((group) => (
          <div class="stack-group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-grid__body">
        <h2 id="about-title">One person, from first sketch to handover.</h2>
        <p>
          DikaGlorya builds under the developer identity DikaCode. ObitoGlory is the website
          brand: one place for the projects, honest notes, and official links.
        </p>
        <div class="about-actions">
          <a class="btn" href="/about/">
            About DikaGlorya <Arrow class="about-arrow" />
          </a>
        </div>
      </div>

      <dl class="about-facts">
        {facts.map((fact) => (
          <div>
            <dt class="fact__label mono">{fact.label}</dt>
            <dd class="fact__value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="follow-title">
    <div class="container follow-grid">
      <div>
        <h2 id="follow-title">Follow the work.</h2>
        <p>
          Project updates land on this site first. The official profiles below are verified
          from this domain and point at the same person behind the name.
        </p>
      </div>
      <ul class="profile-links mono" aria-label="Official public profiles">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} rel="me noopener noreferrer" target="_blank" data-outbound={link.label.toLowerCase()}>
              {link.label} <span>{link.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBlock id="home-contact-title" />
</BaseLayout>
