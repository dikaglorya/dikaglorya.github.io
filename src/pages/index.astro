---
import ContactBlock from '../components/ContactBlock.astro';
import HeroScene from '../components/HeroScene.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import ProjectRow from '../components/ProjectRow.astro';
import RouteDiagram from '../components/RouteDiagram.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { facts } from '../data/facts';
import { projects } from '../data/projects';
import { site, socialLinks } from '../data/site';
import { currentFocus, technologyGroups } from '../data/technologies';
import { articles } from '../data/articles';

const featured = projects.find((project) => project.slug === 'dikaroute');
const selected = projects.filter((project) => project.slug !== 'dikaroute').slice(0, 5);

const capabilities = [
  {
    title: 'Website',
    body: 'Website responsif dan aplikasi web kecil dengan struktur jelas, diuji sebelum diserahkan.',
  },
  {
    title: 'Bot dan integrasi',
    body: 'Otomasi alur kerja dan integrasi Telegram, WhatsApp, serta Discord.',
  },
  {
    title: 'Tools developer',
    body: 'Utilitas, skrip, dan eksperimen untuk membantu workflow developer, termasuk AI agent lokal.',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'ObitoGlory',
  url: site.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.personName,
    alternateName: site.alternateNames,
    url: site.url,
    image: new URL(site.profileImage, site.url).href,
    jobTitle: 'Developer independen',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Jawa Tengah',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title={site.title}
  description={site.description}
  schema={homeSchema}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__body">
          <p class="hero__eyebrow mono">Developer independen · Kendal, Indonesia</p>
          <h1 class="hero__title" id="hero-title">
            <span class="line"><span>Website, bot,</span></span>
            <span class="line"><span>dan tools developer.</span></span>
          </h1>
          <p class="hero__copy">
            Saya DikaGlorya, dikenal juga sebagai DikaOfc dan DikaCode. Saya membuat software dari
            Kendal; ObitoGlory memuat proyek, catatan teknis, dan eksperimen yang saya kerjakan.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/projects/">Lihat proyek</a>
            <a class="btn" href="/contact/">Hubungi saya</a>
          </div>
          <div class="hero__meta mono">
            <span>{site.location}</span>
            <span>{site.availability}</span>
          </div>
        </div>
        <div class="hero__visual">
          <HeroScene />
          <PortraitFrame
            class="hero__portrait"
            sizes="(max-width: 1120px) 250px, 280px"
            caption="DikaGlorya, developer"
            index="ObitoGlory"
            priority
          />
        </div>
      </div>
    </div>
  </section>

  <div class="identity-strip" role="list" aria-label="Bidang kerja">
    <div class="container identity-strip__row mono">
      <span role="listitem">Pengembangan web</span>
      <span role="listitem">Bot dan automasi</span>
      <span role="listitem">Tools developer</span>
      <span role="listitem">AI dan keamanan</span>
    </div>
  </div>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHead
        id="work-title"
        title="Proyek pilihan"
        meta="Proyek, eksperimen, dan tools."
        link={{ href: '/projects/', label: 'Semua proyek' }}
      />

      {featured && (
        <article class="featured">
          <div class="featured__copy">
            <p class="featured__label mono">
              Studi kasus · source belum publik · {featured.type}
            </p>
            <h3>{featured.name}</h3>
            <p>{featured.summary}</p>
            <p class="mono">{featured.stack.join(' · ')}</p>
            <a class="link" href={`/projects/${featured.slug}/`}>
              Baca studi kasus
            </a>
          </div>
          <figure class="featured__diagram">
            <RouteDiagram />
            <figcaption class="mono">
              Ilustrasi alur request dan pemilihan provider; bukan status koneksi langsung.
            </figcaption>
          </figure>
        </article>
      )}

      <div class="project-list">
        {selected.map((project, index) => (
          <ProjectRow project={project} index={index + 2} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="focus-title">
    <div class="container">
      <SectionHead
        id="focus-title"
        title="Fokus saat ini"
        meta="Topik yang sedang dieksplorasi, bukan klaim produk rilis."
      />
      <ul class="focus-list">
        {currentFocus.map((item, index) => (
          <li>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="journal-title">
    <div class="container">
      <SectionHead
        id="journal-title"
        title="Catatan teknis"
        meta="Detail implementasi dan pelajaran dari prosesnya."
        link={{ href: '/journal/', label: 'Semua catatan' }}
      />
      <div class="journal-list">
        {articles.slice(0, 2).map((article) => (
          <article class="journal-card">
            <p class="mono journal-card__meta">
              {article.date} · {article.readingTime} menit baca
            </p>
            <h3>
              <a href={`/journal/${article.slug}/`}>{article.title}</a>
            </h3>
            <p>{article.description}</p>
            <a class="link" href={`/journal/${article.slug}/`}>Baca catatan</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="capabilities-title">
    <div class="container">
      <SectionHead
        id="capabilities-title"
        title="Yang saya buat"
        meta="Tiga area utama layanan."
      />

      <div class="capability-grid">
        {capabilities.map((capability, index) => (
          <article class="capability">
            <p class="capability__index mono" aria-hidden="true">{`0${index + 1}`}</p>
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))}
      </div>

      <p class="capability-more mono">
        <a class="link" href="/services/">Detail layanan</a>
      </p>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="philosophy-title">
    <div class="container container--narrow">
      <h2 class="philosophy-title" id="philosophy-title">Lebih sedikit noise, software lebih baik.</h2>
      <p class="philosophy-body">
        Setiap hal dibuat untuk kebutuhan nyata, bukan sekadar demo. Sistem dibuat mudah dipahami
        dan dirawat; perbaikan dimulai dengan memahami alurnya.
      </p>
      <p class="philosophy-body">
        Kode dibuat dari awal, diuji, lalu diserahkan sesuai lingkup yang disepakati. Performa dan
        desain yang terarah lebih penting daripada dekorasi.
      </p>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="stack-title">
    <div class="container">
      <SectionHead
        id="stack-title"
        title="Teknologi"
        meta="Tools dikelompokkan berdasarkan penggunaan nyata, bukan skor kemampuan."
      />
      <div class="stack-grid">
        {technologyGroups.map((group) => (
          <div class="stack-group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-grid__body">
        <h2 id="about-title">Satu orang, dari sketsa sampai serah terima.</h2>
        <p>
          DikaGlorya berkarya dengan nama DikaOfc dan DikaCode. ObitoGlory adalah brand website:
          satu tempat untuk melihat proyek, catatan yang jujur, dan tautan resmi.
        </p>
        <div class="about-actions">
          <a class="btn" href="/about/">
            Tentang DikaGlorya <Arrow class="about-arrow" />
          </a>
        </div>
      </div>

      <dl class="about-facts">
        {facts.map((fact) => (
          <div>
            <dt class="fact__label mono">{fact.label}</dt>
            <dd class="fact__value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--tight-2" aria-labelledby="follow-title">
    <div class="container follow-grid">
      <div>
        <h2 id="follow-title">Ikuti karya terbaru.</h2>
        <p>
          Update proyek dipublikasikan lebih dulu di sini. GitHub adalah profil kode publik yang
          terverifikasi; Telegram merupakan kanal kontak langsung.
        </p>
      </div>
      <ul class="profile-links mono" aria-label="Profil publik">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} rel="me noopener noreferrer" target="_blank" data-outbound={link.label.toLowerCase()}>
              {link.label} <span>{link.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBlock id="home-contact-title" />
</BaseLayout>
