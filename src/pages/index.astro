---
import ContactBlock from '../components/ContactBlock.astro';
import AssetExplorer from '../components/AssetExplorer.astro';
import HeroScene from '../components/HeroScene.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import ProjectArt from '../components/ProjectArt.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceGlyph from '../components/ServiceGlyph.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { articles } from '../data/articles';
import { facts } from '../data/facts';
import { projects } from '../data/projects';
import { services } from '../data/services';
import { site } from '../data/site';

const rail = projects.filter((project) => project.featured).slice(0, 5);
const featured = projects.find((project) => project.slug === 'dikaroute');
const glyphByService: Record<string, 'website' | 'bot' | 'tools' | 'repairs'> = {
  website: 'website',
  bot: 'bot',
  tools: 'tools',
  repairs: 'repairs',
};

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'ObitoGlory, portofolio DikaGlorya',
  url: site.url,
  inLanguage: 'id',
  mainEntity: { '@id': `${site.url}/#person` },
  about: { '@id': `${site.url}/#studio` },
  hasPart: rail.map((project, index) => ({
    '@type': 'CreativeWork',
    position: index + 1,
    name: project.name,
    url: `${site.url}/projects/${project.slug}/`,
  })),
};
---

<BaseLayout
  title="DikaGlorya (DikaOfc) | Developer & Jasa Website Kendal"
  description="Portofolio DikaGlorya (DikaOfc, DikaCode), developer independen di Kendal. Website, bot Telegram, tools, automasi, dan jasa pembuatan website di Kendal."
  schema={homeSchema}
  bodyClass="home"
>
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene />
    <div class="container hero__inner">
      <div class="hero__meta">
        <span class="label">Independent developer · Kendal, ID</span>
        <span class="hero__coords">6°55′S 110°12′E · WIB</span>
      </div>

      <h1 class="hero__title" id="hero-title" data-parallax="-0.05">
        <span class="hero__line">
          <span class="hero__word" data-split>DIKA</span>
          <span class="hero__tag">/ 01</span>
        </span>
        <span class="hero__line hero__line--offset">
          <span class="hero__word hero__word--italic" data-split>GLORYA</span>
          <span class="hero__slash">/</span>
          <span class="hero__tag">DEVELOPER</span>
        </span>
      </h1>

      <div class="hero__bottom">
        <p class="hero__lead">
          Software yang <em>dipakai</em>, bukan cuma dipamerkan. Website, bot, tools, dan
          automasi dari Kendal, Jawa Tengah.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--magnetic" href="#work">Lihat karya</a>
          <a class="btn btn--magnetic" href="/contact/">Mulai proyek</a>
        </div>
        <div class="hero__status">
          <span class="status">{site.availability}</span>
          <span class="mono muted">Balasan tercepat lewat Telegram</span>
        </div>
      </div>
    </div>
    <a class="hero__scroll" href="#work">Gulir</a>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <div class="marquee__group">
        <span>Website</span><span>Bot</span><span>Tools</span><span><em>Automasi</em></span>
        <span>Kendal</span><span>AI</span><span>Android</span>
      </div>
      <div class="marquee__group">
        <span>Website</span><span>Bot</span><span>Tools</span><span><em>Automasi</em></span>
        <span>Kendal</span><span>AI</span><span>Android</span>
      </div>
    </div>
  </div>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <div class="container manifesto__grid">
      <p class="label">01 / Pendekatan</p>
      <p class="manifesto__text" id="manifesto-title">
        Saya membuat software yang <em>selesai</em>, bukan demo yang berhenti di mockup.
        Struktur jelas, alur diuji, dan hasilnya bisa dipakai.
      </p>
      <p class="manifesto__meta">
        <span>Kendal, Jawa Tengah</span>
        <span>Web / Bot / Tools</span>
        <span>Terbuka untuk proyek</span>
      </p>
    </div>
  </section>

  <section class="section work" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHead
        id="work-title"
        index="02 / Karya"
        title="Objek yang dipakai."
        meta="Proyek pilihan, dari gateway AI sampai tools Termux. Setiap objek punya alasan untuk ada."
        link={{ href: '/projects/', label: 'Semua proyek' }}
      />

      <div class="work-rail">
        {rail.map((project, index) => (
          <a class="work-card" href={`/projects/${project.slug}/`} data-tilt>
            <div class="work-card__art">
              <span class="work-card__index mono">{String(index + 1).padStart(2, '0')}</span>
              <ProjectArt slug={project.slug} name={project.name} index={index + 1} />
            </div>
            <div class="work-card__body">
              <div class="work-card__title">
                {project.name}
                <span>{project.type}</span>
              </div>
              <p class="work-card__tagline">{project.tagline}</p>
              <p class="work-card__stack">{project.stack.join(' / ')}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="work-footer">
        <a class="link" href="/projects/">Lihat semua proyek</a>
        <span class="mono muted">05 objek / {projects.length} total</span>
      </div>
    </div>
  </section>

  {featured && (
    <section class="section featured-project" aria-labelledby="featured-title">
      <div class="container featured-project__grid">
        <div class="featured-project__copy" data-reveal>
          <p class="label">Studi kasus / 01</p>
          <h2 class="featured-project__title" id="featured-title">{featured.name}</h2>
          <p class="featured-project__summary">{featured.summary}</p>
          <ul class="featured-project__features">
            {featured.features.slice(0, 4).map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
          <a class="link" href={`/projects/${featured.slug}/`}>Baca studi kasus</a>
        </div>
        <div class="featured-project__art" data-tilt data-reveal>
          <ProjectArt slug={featured.slug} name={featured.name} index={featured.order} />
        </div>
      </div>
    </section>
  )}

  <section class="section asset-explorer-section" aria-labelledby="explorer-title">
    <div class="container">
      <SectionHead
        id="explorer-title"
        index="03 / Eksplorasi"
        title="Objek yang bisa disentuh."
        meta="Model 3D interaktif — ganti material, putar, dan bongkar bentuknya."
      />
      <AssetExplorer />
    </div>
  </section>

  <section class="section" aria-labelledby="capabilities-title">
    <div class="container">
      <SectionHead
        id="capabilities-title"
        index="04 / Kapabilitas"
        title="Yang bisa dibangun."
        meta="Empat area kerja, dari halaman pertama sampai perbaikan sistem yang sudah berjalan."
      />

      <div class="capability-list">
        {services.map((service, index) => (
          <article class="capability-row" data-reveal>
            <div class="capability-row__glyph">
              <ServiceGlyph kind={glyphByService[service.slug] ?? 'tools'} />
            </div>
            <div class="capability-row__body">
              <span class="capability-row__index mono">0{index + 1}</span>
              <h3 class="capability-row__title">{service.name}</h3>
              <p class="capability-row__copy">{service.description}</p>
            </div>
            <ul class="capability-row__list">
              {service.includes.slice(0, 4).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-band" aria-labelledby="about-title">
    <div class="container about-grid">
      <PortraitFrame
        class="about-portrait"
        sizes="(max-width: 900px) 100vw, 38vw"
        caption="DikaGlorya, developer"
        index="Portrait / 01"
      />

      <div class="about-grid__body" data-reveal>
        <p class="label">05 / Tentang</p>
        <h2 id="about-title">Lebih sedikit noise, <em>lebih banyak</em> yang dipakai.</h2>
        <p>
          Saya DikaGlorya, developer independen dari Kendal. DikaCode adalah identitas untuk
          karya software; ObitoGlory adalah rumah untuk proyek, catatan teknis, dan cara saya
          bekerja.
        </p>
        <p>
          Setiap hal dibuat untuk kebutuhan nyata. Struktur dibuat mudah dipahami dan dirawat;
          perbaikan dimulai dengan memahami alurnya.
        </p>

        <dl class="about-facts">
          {facts.map((fact) => (
            <div>
              <dt class="fact__label mono">{fact.label}</dt>
              <dd class="fact__value">{fact.value}</dd>
            </div>
          ))}
        </dl>

        <a class="link" href="/about/">Kenali cara kerja</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="journal-title">
    <div class="container">
      <SectionHead
        id="journal-title"
        index="06 / Jurnal"
        title="Catatan dari proses."
        meta="Detail implementasi dan keputusan teknis yang bisa diperiksa."
        link={{ href: '/journal/', label: 'Semua catatan' }}
      />

      <div class="home-journal">
        {articles.slice(0, 2).map((article) => (
          <a class="journal-card" href={`/journal/${article.slug}/`} data-reveal>
            <p class="journal-card__meta">
              <time datetime={article.date}>{article.date}</time>
              <span>{article.readingTime} menit baca</span>
            </p>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <ul class="journal-tags" aria-label="Topik">
              {article.tags.map((tag) => (
                <li class="mono">{tag}</li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="local-band" aria-labelledby="local-title">
    <div class="container local-band__inner">
      <h2 class="local-band__title" id="local-title">
        Dari Kendal, untuk <em>yang dipakai.</em>
      </h2>
      <div class="local-band__copy">
        <p>
          Menerima proyek website, bot, dan tools dari Kendal dan sekitarnya. Konsultasi awal
          lewat Telegram, lingkup dan harga disepakati sebelum mulai.
        </p>
        <a class="link" href="/kendal/">Jasa website Kendal</a>
      </div>
    </div>
  </section>

  <ContactBlock id="home-contact-title" title="Ada yang ingin dibuat?" />
</BaseLayout>
