---
import ContactBlock from '../../components/ContactBlock.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectCategories, projects } from '../../data/projects';
import { site } from '../../data/site';
import BilingualCopy from '../../components/BilingualCopy.astro';

const categoryCounts = projectCategories.map((category) => ({
  category,
  count: projects.filter((project) => project.category === category).length,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Selected work, ObitoGlory',
  description:
    'Case studies of practical software, web projects, bots, Android apps, and developer tools by DikaGlorya.',
  url: `${site.url}/projects/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/projects/${project.slug}/`,
      name: project.name,
    })),
  },
};
---

<BaseLayout
  title="Projects / Proyek | DikaGlorya (DikaOfc) | ObitoGlory"
  description="Proyek dan software buatan DikaGlorya, dikenal juga sebagai DikaOfc dan DikaCode: website, bot, Android, dan developer tools. Explore practical software and developer projects by DikaGlorya."
  schema={schema}
>
  <section class="page-hero page-hero--projects" aria-labelledby="projects-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Portfolio / portofolio · project index / daftar proyek</p>
      <h1 id="projects-title">Selected work / Proyek pilihan</h1>
      <BilingualCopy
        class="page-hero__lead"
        en="Projects, tools, and experiments documented as concise technical case studies."
        id="Proyek, tools, dan eksperimen yang dijelaskan melalui studi kasus teknis singkat."
      />
      <div class="page-hero__meta mono">
        <span>{`${projects.length} projects`}</span>
        <span>{`${projectCategories.length} categories`}</span>
        <span>{site.locationShort}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-label="Project list">
    <div class="container">
      <div class="filter-bar" data-js-only role="group" aria-label="Filter projects">
        <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">
          All / Semua ({projects.length})
        </button>
        {categoryCounts.map((item) => (
          <button class="filter-btn" type="button" data-filter={item.category} aria-pressed="false">
            {item.category} ({item.count})
          </button>
        ))}
      </div>

      <p class="filter-count mono" data-project-count aria-live="polite">
        {`${projects.length} projects shown / proyek ditampilkan`}
      </p>

      <div class="project-list">
        <div class="project-list__head mono" aria-hidden="true">
          <span>No. / No.</span>
          <span>Project / Proyek</span>
          <span>Type / Jenis</span>
          <span>Stack / Teknologi</span>
          <span>Detail / Detail</span>
        </div>
        {projects.map((project, index) => (
          <ProjectRow project={project} index={index + 1} />
        ))}
      </div>

      <div class="empty-state" data-empty-state hidden>
        <p>No projects in this category / Tidak ada proyek dalam kategori ini.</p>
        <p>
          <button class="link" type="button" data-filter="all">Show all projects / Tampilkan semua proyek</button>
        </p>
      </div>

      <div class="projects-note mono">
        <p>Source code belum dipublikasikan / Project repositories are not public. Lihat profil GitHub untuk kode yang memang tersedia / See GitHub for public code.</p>
        <a
          class="link"
          href="https://github.com/dikaglorya"
          rel="me noopener noreferrer"
          target="_blank"
        >
          github.com/dikaglorya
        </a>
      </div>
    </div>
  </section>

  <ContactBlock
    id="projects-contact-title"
    title="Missing the project you had in mind? / Belum menemukan proyek yang kamu cari?"
  />

  <script>
    import '../../scripts/projects';
  </script>
</BaseLayout>
