---
import ContactBlock from '../../components/ContactBlock.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectCategories, projects } from '../../data/projects';
import { site } from '../../data/site';

const categoryCounts = projectCategories.map((category) => ({
  category,
  count: projects.filter((project) => project.category === category).length,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Proyek pilihan, ObitoGlory',
  description:
    'Studi kasus software praktis, proyek web, bot, aplikasi Android, dan developer tools karya DikaGlorya.',
  url: `${site.url}/projects/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/projects/${project.slug}/`,
      name: project.name,
    })),
  },
};
---

<BaseLayout
  title="Proyek | DikaGlorya (DikaOfc) | ObitoGlory"
  description="Proyek dan software buatan DikaGlorya, dikenal juga sebagai DikaOfc dan DikaCode: website, bot, Android, dan developer tools."
  schema={schema}
>
  <section class="page-hero page-hero--projects" aria-labelledby="projects-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Portofolio · daftar proyek</p>
      <h1 id="projects-title">Proyek pilihan</h1>
      <p class="page-hero__lead">
        Proyek, tools, dan eksperimen yang dijelaskan melalui studi kasus teknis singkat.
      </p>
      <div class="page-hero__meta mono">
        <span>{`${projects.length} proyek`}</span>
        <span>{`${projectCategories.length} kategori`}</span>
        <span>{site.locationShort}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-label="Daftar proyek">
    <div class="container">
      <div class="filter-bar" role="group" aria-label="Filter proyek">
        <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">
          Semua ({projects.length})
        </button>
        {categoryCounts.map((item) => (
          <button class="filter-btn" type="button" data-filter={item.category} aria-pressed="false">
            {item.category} ({item.count})
          </button>
        ))}
      </div>

      <p class="filter-count mono" data-project-count aria-live="polite">
        {`${projects.length} proyek ditampilkan`}
      </p>

      <div class="project-list">
        <div class="project-list__head mono" aria-hidden="true">
          <span>No.</span>
          <span>Proyek</span>
          <span>Jenis</span>
          <span>Teknologi</span>
          <span>Detail</span>
        </div>
        {projects.map((project, index) => (
          <ProjectRow project={project} index={index + 1} />
        ))}
      </div>

      <div class="empty-state" data-empty-state hidden>
        <p>Tidak ada proyek dalam kategori ini.</p>
        <p>
          <button class="link" type="button" data-filter="all">Tampilkan semua proyek</button>
        </p>
      </div>

      <div class="projects-note mono">
        <p>Kode sumber belum dipublikasikan. Lihat profil GitHub untuk kode yang memang tersedia.</p>
        <a
          class="link"
          href="https://github.com/dikaglorya"
          rel="me noopener noreferrer"
          target="_blank"
        >
          github.com/dikaglorya
        </a>
      </div>
    </div>
  </section>

  <ContactBlock
    id="projects-contact-title"
    title="Belum menemukan proyek yang kamu cari?"
  />

  <script>
    import '../../scripts/projects';
  </script>
</BaseLayout>
