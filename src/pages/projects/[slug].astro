---
import ContactBlock from '../../components/ContactBlock.astro';
import BilingualCopy from '../../components/BilingualCopy.astro';
import RouteDiagram from '../../components/RouteDiagram.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNextProject, projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const nextProject = getNextProject(project.slug);
const paddedOrder = String(project.order).padStart(2, '0');
const service =
  project.category === 'Web'
    ? 'website'
    : project.category === 'Android'
      ? 'tools'
      : project.category === 'Developer tools'
        ? 'tools'
        : project.category === 'Security & automation'
          ? 'repairs'
          : 'bot';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: project.summary,
  url: `${site.url}/projects/${project.slug}/`,
  author: {
    '@id': `${site.url}/#person`,
  },
  keywords: project.stack.join(', '),
  genre: project.category,
  isPartOf: {
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={`${project.name} | DikaOfc / DikaGlorya | ObitoGlory`}
  description={`${project.summaryId} / ${project.summary}`}
  type="article"
  schema={schema}
>
  <article>
    <header class="project-hero">
      <div class="container">
        <nav class="breadcrumb mono" aria-label="Breadcrumb">
          <a href="/projects/">Projects / Proyek</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">{project.name}</span>
        </nav>

        <div class="project-hero__meta mono">
          <span>Project {paddedOrder}</span>
          <span>{project.type}</span>
          <span>{project.category}</span>
        </div>

        <h1 class="project-hero__title">{project.name}</h1>
        <p class="project-hero__tagline">{project.tagline}</p>

        <div class="project-hero__actions">
          <a class="btn btn--primary" href={`/contact/?service=${service}`}>
            Discuss a project / Diskusikan proyek serupa
          </a>
          <a class="btn" href="/projects/">All projects / Semua proyek</a>
        </div>
      </div>
    </header>

    <div class="container project-layout">
      <div class="project-content">
        <section class="project-section">
          <h2>Overview / Ringkasan</h2>
          <BilingualCopy en={project.summary} id={project.summaryId} />
        </section>

        <section class="project-section">
          <h2>The problem / Masalah</h2>
          <BilingualCopy en={project.problem} id={project.problemId} />
        </section>

        <section class="project-section">
          <h2>What was built / Yang dibuat</h2>
          <BilingualCopy en={project.approach} id={project.approachId} />
          <ul class="feature-list">
            {project.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </section>

        <section class="project-section">
          <h2>Availability and limitations / Ketersediaan dan batasan</h2>
          <BilingualCopy
            en={
              project.link?.kind === 'package'
                ? `A published package is available: ${project.link.label}. Installing it lets you run the implementation yourself. The source repository is not linked, so the internals still cannot be read here.`
                : project.link
                  ? `A public link is available: ${project.link.label}. The source repository is not linked, so the internals cannot be read here.`
                  : 'The source code and a public demo are not linked for this project. This page documents the described scope, but without a public source or demo a visitor cannot independently inspect or run the implementation.'
            }
            id={
              project.link?.kind === 'package'
                ? `Paket publik tersedia: ${project.link.label}. Dengan memasangnya, implementasinya bisa dijalankan sendiri. Repositori sumber tidak ditautkan, jadi bagian dalamnya belum bisa dibaca di sini.`
                : project.link
                  ? `Tautan publik tersedia: ${project.link.label}. Repositori sumber tidak ditautkan, jadi bagian dalamnya belum bisa dibaca di sini.`
                  : 'Kode sumber dan demo publik belum ditautkan untuk proyek ini. Halaman ini menjelaskan ruang lingkup yang dimaksud; tanpa source atau demo publik, pengunjung belum dapat memeriksa atau menjalankan implementasinya sendiri.'
            }
          />
        </section>

        {project.slug === 'dikaroute' && (
          <figure class="project-figure">
            <RouteDiagram />
            <figcaption class="mono">
              Konsep: satu request, satu provider yang tersedia, fallback otomatis jika gagal.
              / Concept: one request, one available provider, automatic fallback on failure.
            </figcaption>
          </figure>
        )}

        {project.note && (
          <div class="project-note">
            <p><strong>Note:</strong> {project.note}</p>
          </div>
        )}

        {!project.link && (
          <div class="project-note">
            <p>
              <strong>Source:</strong> this project is not public. Ask for a walkthrough if you
              want to see how it was built.
            </p>
          </div>
        )}
      </div>

      <aside class="project-aside" aria-label="Project details">
        <dl class="spec">
          <div class="spec__row">
            <dt class="spec__label mono">Type</dt>
            <dd class="spec__value">{project.type}</dd>
          </div>
          <div class="spec__row">
            <dt class="spec__label mono">Category</dt>
            <dd class="spec__value">{project.category}</dd>
          </div>
          <div class="spec__row">
            <dt class="spec__label mono">Stack</dt>
            <dd class="spec__value">{project.stack.join(', ')}</dd>
          </div>
          <div class="spec__row">
            <dt class="spec__label mono">Source</dt>
            <dd class="spec__value">Not public</dd>
          </div>
          {project.link && (
            <div class="spec__row">
              <dt class="spec__label mono">{project.link.kind === 'package' ? 'Package' : 'Live'}</dt>
              <dd class="spec__value">
                <a href={project.link.href} rel="noopener noreferrer" target="_blank" data-outbound="project-live">
                  {project.link.label}
                </a>
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>

    <div class="container">
      <a class="next-project" href={`/projects/${nextProject.slug}/`}>
        <span class="mono">Next project / Proyek berikutnya</span>
        <span class="next-project__name">{nextProject.name}</span>
      </a>
    </div>
  </article>

  <ContactBlock id="project-contact-title" title="Need a system like this? / Butuh sistem seperti ini?" />
</BaseLayout>
