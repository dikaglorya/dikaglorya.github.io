---
import ContactBlock from '../../components/ContactBlock.astro';
import RouteDiagram from '../../components/RouteDiagram.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNextProject, projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const nextProject = getNextProject(project.slug);
const paddedOrder = String(project.order).padStart(2, '0');

const serviceByCategory: Record<string, string> = {
  Web: 'website',
  Android: 'tools',
  'Tools developer': 'tools',
  'Keamanan & automasi': 'repairs',
};

const service = serviceByCategory[project.category] ?? 'bot';

const availability = project.link
  ? project.link.kind === 'package'
    ? `Paket publik tersedia: ${project.link.label}. Dengan memasangnya, implementasinya bisa dijalankan sendiri. Repositori sumber tidak ditautkan, jadi bagian dalamnya belum bisa dibaca di sini.`
    : `Tautan publik tersedia: ${project.link.label}. Repositori sumber tidak ditautkan, jadi bagian dalamnya belum bisa dibaca di sini.`
  : 'Kode sumber dan demo publik belum ditautkan untuk proyek ini. Halaman ini menjelaskan ruang lingkup yang dimaksud; tanpa source atau demo publik, pengunjung belum dapat memeriksa atau menjalankan implementasinya sendiri.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: project.summary,
  url: `${site.url}/projects/${project.slug}/`,
  author: {
    '@id': `${site.url}/#person`,
  },
  keywords: project.stack.join(', '),
  genre: project.category,
  inLanguage: 'id',
  isPartOf: {
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={`${project.name} | DikaOfc (DikaGlorya) | ObitoGlory`}
  description={project.summary}
  type="article"
  schema={schema}
>
  <article>
    <header class="project-hero">
      <div class="container">
        <nav class="breadcrumb mono" aria-label="Remah roti">
          <a href="/projects/">Proyek</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">{project.name}</span>
        </nav>

        <div class="project-hero__meta mono">
          <span>Proyek {paddedOrder}</span>
          <span>{project.type}</span>
          <span>{project.category}</span>
        </div>

        <h1 class="project-hero__title">{project.name}</h1>
        <p class="project-hero__tagline">{project.tagline}</p>

        <div class="project-hero__actions">
          <a class="btn btn--primary" href={`/contact/?service=${service}`}>
            Diskusikan proyek serupa
          </a>
          <a class="btn" href="/projects/">Semua proyek</a>
        </div>
      </div>
    </header>

    <div class="container project-layout">
      <div class="project-content">
        <section class="project-section">
          <h2>Ringkasan</h2>
          <p>{project.summary}</p>
        </section>

        <section class="project-section">
          <h2>Masalah</h2>
          <p>{project.problem}</p>
        </section>

        <section class="project-section">
          <h2>Yang dibuat</h2>
          <p>{project.approach}</p>
          <ul class="feature-list">
            {project.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </section>

        <section class="project-section">
          <h2>Ketersediaan dan batasan</h2>
          <p>{availability}</p>
        </section>

        {project.slug === 'dikaroute' && (
          <figure class="project-figure">
            <RouteDiagram />
            <figcaption class="mono">
              Ilustrasi alur request dan pemilihan provider; bukan status koneksi langsung.
            </figcaption>
          </figure>
        )}

        {project.note && (
          <div class="project-note">
            <p><strong>Catatan:</strong> {project.note}</p>
          </div>
        )}

        {!project.link && (
          <div class="project-note">
            <p>
              <strong>Source:</strong> proyek ini tidak publik. Silakan minta penjelasan langsung
              jika ingin melihat cara pembuatannya.
            </p>
          </div>
        )}
      </div>

      <aside class="project-aside" aria-label="Detail proyek">
        <dl class="spec">
          <div class="spec__row">
            <dt class="spec__label mono">Jenis</dt>
            <dd class="spec__value">{project.type}</dd>
          </div>
          <div class="spec__row">
            <dt class="spec__label mono">Kategori</dt>
            <dd class="spec__value">{project.category}</dd>
          </div>
          <div class="spec__row">
            <dt class="spec__label mono">Teknologi</dt>
            <dd class="spec__value">{project.stack.join(', ')}</dd>
          </div>
          <div class="spec__row">
            <dt class="spec__label mono">Source</dt>
            <dd class="spec__value">Tidak publik</dd>
          </div>
          {project.link && (
            <div class="spec__row">
              <dt class="spec__label mono">{project.link.kind === 'package' ? 'Paket' : 'Live'}</dt>
              <dd class="spec__value">
                <a href={project.link.href} rel="noopener noreferrer" target="_blank" data-outbound="project-live">
                  {project.link.label}
                </a>
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>

    <div class="container">
      <a class="next-project" href={`/projects/${nextProject.slug}/`}>
        <span class="mono">Proyek berikutnya</span>
        <span class="next-project__name">{nextProject.name}</span>
      </a>
    </div>
  </article>

  <ContactBlock id="project-contact-title" title="Butuh sistem seperti ini?" />
</BaseLayout>
