---
import ContactBlock from '../../components/ContactBlock.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, type Article } from '../../data/articles';
import { site } from '../../data/site';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const canonical = `${site.url}/journal/${article.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': canonical,
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  dateModified: article.date,
  mainEntityOfPage: canonical,
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#website` },
  keywords: article.tags.join(', '),
  inLanguage: 'id',
};
---

<BaseLayout
  title={`${article.title} | DikaOfc`}
  description={article.description}
  type="article"
  schema={schema}
>
  <article>
    <header class="page-hero journal-hero">
      <div class="container">
        <nav class="breadcrumb mono" aria-label="Remah roti">
          <a href="/journal/">Jurnal</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">Artikel</span>
        </nav>
        <p class="page-hero__eyebrow mono">Catatan teknis · {site.personName} (DikaOfc)</p>
        <h1>{article.title}</h1>
        <p class="page-hero__lead">{article.description}</p>
        <div class="page-hero__meta mono">
          <time datetime={article.date}>{article.date}</time>
          <span>{article.readingTime} menit baca</span>
          <span>{article.tags.join(' · ')}</span>
        </div>
      </div>
    </header>

    <div class="container journal-article">
      {article.sections.map((section) => (
        <section class="journal-section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.code && (
            <pre class="journal-code" tabindex="0" aria-label={`Contoh kode: ${section.heading}`}>
              <code>{section.code}</code>
            </pre>
          )}
        </section>
      ))}
      <p class="journal-source mono">
        Catatan ini menjelaskan implementasi di repositori website ini. Tidak ada klaim tentang
        peringkat pencarian, benchmark performa, atau adopsi proyek.
      </p>
      <a class="link" href="/journal/">Kembali ke semua catatan</a>
    </div>
  </article>

  <ContactBlock id="article-contact-title" title="Mau diskusi soal implementasi ini?" />
</BaseLayout>
