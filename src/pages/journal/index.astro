---
import ContactBlock from '../../components/ContactBlock.astro';
import BilingualCopy from '../../components/BilingualCopy.astro';
import SectionHead from '../../components/SectionHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
import { site } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Technical journal, ObitoGlory',
  url: `${site.url}/journal/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/journal/${article.slug}/`,
      name: `${article.titleId} / ${article.title}`,
    })),
  },
};
---

<BaseLayout
  title="Jurnal teknis / Technical Journal | DikaGlorya (DikaOfc)"
  description="Catatan teknis DikaGlorya (DikaOfc) tentang software, website, developer tools, dan keputusan engineering / Technical notes by DikaGlorya about developer tools, web engineering, and real implementation decisions."
  schema={schema}
>
  <section class="page-hero" aria-labelledby="journal-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Journal / Jurnal · engineering notes / catatan engineering</p>
      <h1 id="journal-title">Notes from the work. / Catatan dari proses berkarya.</h1>
      <BilingualCopy
        class="page-hero__lead"
        en="Practical explanations of implementation choices and trade-offs from software that can be inspected."
        id="Penjelasan praktis tentang pilihan implementasi dan kompromi dari software yang dapat diperiksa."
      />
      <div class="page-hero__meta mono">
        <span>{articles.length} published note{articles.length === 1 ? '' : 's'}</span>
        <span>Written by {site.personName}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="notes-title">
    <div class="container">
      <SectionHead id="notes-title" title="Published notes / Catatan terbit" meta="Each article connects its claims to real implementation details / Setiap artikel merujuk pada detail implementasi nyata." />
      <div class="journal-list journal-list--index">
        {articles.map((article) => (
          <article class="journal-card">
            <p class="mono journal-card__meta">
              <time datetime={article.date}>{article.date}</time> / {article.readingTime} min read
            </p>
            <h2><a href={`/journal/${article.slug}/`}>{article.titleId} / {article.title}</a></h2>
            <BilingualCopy en={article.description} id={article.descriptionId} />
            <ul class="journal-tags" aria-label="Topics">
              {article.tags.map((tag) => <li class="mono">{tag}</li>)}
            </ul>
            <a class="link" href={`/journal/${article.slug}/`}>Read / Baca artikelnya</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock id="journal-contact-title" title="Have a question? / Ada pertanyaan tentang implementasi?" />
</BaseLayout>
