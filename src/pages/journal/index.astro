---
import ContactBlock from '../../components/ContactBlock.astro';
import SectionHead from '../../components/SectionHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
import { site } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Technical journal, ObitoGlory',
  url: `${site.url}/journal/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/journal/${article.slug}/`,
      name: article.title,
    })),
  },
};
---

<BaseLayout
  title="Technical Journal | ObitoGlory"
  description="Practical technical notes by DikaGlorya about developer tools, web engineering, and decisions verified in real projects."
  schema={schema}
>
  <section class="page-hero" aria-labelledby="journal-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Journal / engineering notes</p>
      <h1 id="journal-title">Notes from the work.</h1>
      <p class="page-hero__lead">
        Practical explanations of implementation choices, trade-offs, and lessons drawn from
        software that can be inspected. No invented benchmarks or case studies.
      </p>
      <div class="page-hero__meta mono">
        <span>{articles.length} published note{articles.length === 1 ? '' : 's'}</span>
        <span>Written by {site.personName}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="notes-title">
    <div class="container">
      <SectionHead id="notes-title" title="Published notes" meta="Each article links its claims to real implementation details." />
      <div class="journal-list journal-list--index">
        {articles.map((article) => (
          <article class="journal-card">
            <p class="mono journal-card__meta">
              <time datetime={article.date}>{article.date}</time> / {article.readingTime} min read
            </p>
            <h2><a href={`/journal/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.description}</p>
            <ul class="journal-tags" aria-label="Topics">
              {article.tags.map((tag) => <li class="mono">{tag}</li>)}
            </ul>
            <a class="link" href={`/journal/${article.slug}/`}>Read the article</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock id="journal-contact-title" title="Have a question about an implementation?" />
</BaseLayout>
