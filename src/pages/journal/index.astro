---
import ContactBlock from '../../components/ContactBlock.astro';
import SectionHead from '../../components/SectionHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/detail.css';
import { articles } from '../../data/articles';
import { site } from '../../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Jurnal teknis, ObitoGlory',
  url: `${site.url}/journal/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${site.url}/journal/${article.slug}/`,
      name: article.title,
    })),
  },
};
---

<BaseLayout
  title="Jurnal teknis | DikaGlorya (DikaOfc) | ObitoGlory"
  description="Catatan teknis DikaGlorya (DikaOfc) tentang software, website, developer tools, dan keputusan engineering."
  schema={schema}
>
  <section class="page-hero" aria-labelledby="journal-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Jurnal · catatan engineering</p>
      <h1 id="journal-title">Catatan dari proses berkarya.</h1>
      <p class="page-hero__lead">
        Penjelasan praktis tentang pilihan implementasi dan kompromi dari software yang dapat
        diperiksa.
      </p>
      <div class="page-hero__meta mono">
        <span>{`${articles.length} catatan terbit`}</span>
        <span>Ditulis oleh {site.personName}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="notes-title" data-reveal>
    <div class="container">
      <SectionHead id="notes-title" index="01 / Arsip" title="Catatan terbit" meta="Setiap artikel merujuk pada detail implementasi nyata." />
      <div class="journal-list">
        {articles.map((article) => (
          <article class="journal-card">
            <p class="mono journal-card__meta">
              <time datetime={article.date}>{article.date}</time> · {article.readingTime} menit baca
            </p>
            <h2><a href={`/journal/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.description}</p>
            <ul class="journal-tags" aria-label="Topik">
              {article.tags.map((tag) => <li class="mono">{tag}</li>)}
            </ul>
            <a class="link" href={`/journal/${article.slug}/`}>Baca artikelnya</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock id="journal-contact-title" title="Ada pertanyaan tentang implementasi?" />
</BaseLayout>
