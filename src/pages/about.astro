---
import ContactBlock from '../components/ContactBlock.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import StackGrid from '../components/StackGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { principles } from '../data/facts';
import { site } from '../data/site';
import { currentFocus } from '../data/technologies';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Tentang ObitoGlory',
  url: `${site.url}/about/`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.personName,
    alternateName: site.alternateNames,
    url: site.url,
    image: new URL(site.profileImage, site.url).href,
    jobTitle: 'Developer independen',
    description:
      'Developer independen dari Kendal, Jawa Tengah, yang membuat website, bot, AI tools, dan automasi keamanan.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Jawa Tengah',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title="Tentang DikaGlorya (DikaOfc) | ObitoGlory"
  description="Tentang DikaGlorya, dikenal juga sebagai DikaOfc dan DikaCode: developer independen dari Kendal, Indonesia. Kenali identitas, karya, dan tautan resminya."
  type="profile"
  schema={schema}
>
  <section class="page-hero page-hero--about" aria-labelledby="about-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Tentang DikaGlorya (DikaOfc)</p>
      <h1 id="about-title">Satu developer, dari awal hingga serah terima.</h1>
      <p class="page-hero__lead">
        Saya membuat website, bot, AI tools, dan automasi keamanan. Lingkup pekerjaan disepakati
        sebelum mulai.
      </p>
      <div class="page-hero__meta mono">
        <span>{site.location}</span>
        <span>Nama pribadi · nama developer · brand website</span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-label="Perkenalan" data-reveal>
    <div class="container profile-grid">
      <div class="profile-body">
        <h2 id="profile-title">Bukan perusahaan besar. Satu orang yang serius mengerjakan karya.</h2>
        <p>
          DikaGlorya adalah programmer independen dari Kendal, Jawa Tengah. DikaCode adalah
          identitas developer untuk karya software; ObitoGlory adalah nama website dan portofolio
          ini.
        </p>
        <p>
          DikaOfc dan DikaGlory adalah nama publik lain yang digunakan orang yang sama, bukan orang
          berbeda. Dika Developer adalah sebutan profesi. Halaman ini menghubungkan nama-nama
          tersebut dengan karya dan tautan resmi.
        </p>
      </div>
      <PortraitFrame
        class="profile-portrait"
        sizes="(max-width: 900px) 320px, 360px"
      />
    </div>
  </section>

  <section class="section--tight" aria-labelledby="identity-title" data-reveal>
    <div class="container">
      <SectionHead
        id="identity-title"
        index="01 / Identitas"
        title="Satu orang, beberapa nama publik"
        meta="Konteks setiap nama dijelaskan dengan jujur."
      />
      <dl class="identity-list">
        <div><dt>DikaGlorya</dt><dd>Identitas pribadi utama.</dd></div>
        <div><dt>DikaOfc</dt><dd>Nama publik lain yang digunakan DikaGlorya.</dd></div>
        <div><dt>DikaCode</dt><dd>Identitas developer untuk karya software.</dd></div>
        <div><dt>ObitoGlory</dt><dd>Brand website dan portofolio.</dd></div>
        <div><dt>DikaGlory</dt><dd>Nama publik lain untuk orang yang sama.</dd></div>
        <div><dt>Dika Developer</dt><dd>Sebutan profesi, bukan orang lain.</dd></div>
        <div><dt>Dika Kendal</dt><dd>Nama yang terkait lokasi; berbasis di Kendal.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="principles-title" data-reveal>
    <div class="container">
      <SectionHead
        id="principles-title"
        index="02 / Prinsip"
        title="Cara kerja"
        meta="Tiga prinsip sebelum mengerjakan proyek."
      />
      <ul class="principle-list">
        {principles.map((principle, index) => (
          <li class="principle">
            <span class="principle__index mono" aria-hidden="true">{`0${index + 1}`}</span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="focus-title" data-reveal>
    <div class="container">
      <SectionHead
        id="focus-title"
        index="03 / Fokus"
        title="Fokus saat ini"
        meta="Hal yang sedang dipelajari dan dieksplorasi."
      />
      <ul class="focus-list">
        {currentFocus.map((item, index) => (
          <li>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="stack-title" data-reveal>
    <div class="container">
      <SectionHead
        id="stack-title"
        index="04 / Toolkit"
        title="Teknologi dan tools"
        meta="Dikelompokkan berdasarkan fungsi, bukan peringkat."
      />
      <StackGrid />
    </div>
  </section>

  <section class="section--tight" aria-labelledby="profiles-title" data-reveal>
    <div class="container">
      <SectionHead id="profiles-title" index="05 / Tautan" title="Tautan resmi" meta="Tautan publik yang digunakan di website ini." />
      <ul class="profile-links mono">
        <li>
          <a href={site.github} rel="me noopener noreferrer" target="_blank" data-outbound="github">
            GitHub <span>@{site.githubHandle}</span>
          </a>
        </li>
        <li>
          <a href={site.telegramUrl} rel="me" data-outbound="telegram">
            Telegram <span>@{site.telegram}</span>
          </a>
        </li>
        <li>
          <a href={site.instagram} rel="me noopener noreferrer" target="_blank" data-outbound="instagram">
            Instagram <span>@xxcdicka</span>
          </a>
        </li>
        <li>
          <a href={site.tiktok} rel="me noopener noreferrer" target="_blank" data-outbound="tiktok">
            TikTok <span>@dikasecx</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <ContactBlock id="about-contact-title" title="Ingin membahas sistem atau proyek?" />
</BaseLayout>
