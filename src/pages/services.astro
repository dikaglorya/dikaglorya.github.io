---
import ContactBlock from '../components/ContactBlock.astro';
import BilingualCopy from '../components/BilingualCopy.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs';
import { processSteps } from '../data/facts';
import { services } from '../data/services';
import { site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Services, ObitoGlory',
  url: `${site.url}/services/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: services.length,
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.name,
        description: `${service.descriptionId} / ${service.description}`,
        provider: {
          '@id': `${site.url}/#person`,
        },
        areaServed: {
          '@type': 'Country',
          name: 'Indonesia',
        },
      },
    })),
  },
};
---

<BaseLayout
  title="Jasa Website, Bot, dan Tools di Kendal | DikaOfc / DikaGlorya | ObitoGlory"
  description="Jasa pembuatan website, bot Telegram, tools custom, dan perbaikan sistem dari DikaGlorya (DikaOfc / DikaCode), Kendal / Website development, bots, custom tools, and system repair by DikaGlorya in Kendal, Indonesia."
  schema={schema}
>
  <section class="page-hero page-hero--services" aria-labelledby="services-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Services / Layanan · DikaOfc</p>
      <h1 id="services-title">Practical software, built with care. / Software praktis, dibuat dengan teliti.</h1>
      <BilingualCopy
        class="page-hero__lead"
        en="Websites, bots, tools, and repair work for existing systems. Scope and price are agreed before work begins."
        id="Pembuatan website, bot, tools, dan perbaikan sistem. Lingkup serta harga disepakati sebelum pekerjaan dimulai."
      />
      <div class="page-hero__meta mono">
        <span>{`${services.length} services`}</span>
        <span>{site.availability}</span>
        <span>{`Telegram @${site.telegram}`}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" id="pricing" aria-label="Service list">
    <div class="container">
      {services.map((service, index) => (
        <section
          class="service-row"
          id={service.slug}
          aria-labelledby={`${service.slug}-title`}
        >
          <div class="service-row__index mono" aria-hidden="true">{`0${index + 1}`}</div>

          <div class="service-row__body">
            <h2 id={`${service.slug}-title`}>{service.nameId} / {service.name}</h2>
            <BilingualCopy
              class="service-row__lead"
              en={service.description}
              id={service.descriptionId}
            />
            <div class="service-row__cols">
              <div>
                <h3 class="service-row__label mono">Possible deliverables / Hasil yang bisa dibuat</h3>
                <ul class="includes">
                  {service.includes.map((item, itemIndex) => (
                    <li>
                      {item} <span lang="id">/ {service.includesId[itemIndex]}</span>
                    </li>
                  ))}
                </ul>
                {service.platforms && (
                  <p class="mono muted service-row__platforms">
                    Platform / Platforms: {service.platforms.join(' / ')}
                  </p>
                )}
              </div>
              <div>
                <h3 class="service-row__label mono">Scope limits / Batasan lingkup</h3>
                <ul class="includes">
                  {service.limits.map((item, itemIndex) => (
                    <li>
                      {item} <span lang="id">/ {service.limitsId[itemIndex]}</span>
                    </li>
                  ))}
                </ul>
                <p class="mono muted service-row__platforms">
                  Mulai / From {service.priceFrom} · {service.priceNoteId} / {service.priceNote}
                </p>
              </div>
            </div>
            <a class="link" href={`/contact/?service=${service.slug}`}>
              Discuss / Diskusikan layanan ini
            </a>
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section--tight" aria-labelledby="process-title">
    <div class="container">
      <SectionHead
        id="process-title"
        title="Engagement process / Alur kerja"
        meta="Four clear steps, without surprises / Empat langkah jelas tanpa kejutan di tengah jalan."
      />
      <ol class="process-steps">
        {processSteps.map((step, index) => (
          <li>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.titleId} / {step.title}</h3>
            <BilingualCopy en={step.body} id={step.bodyId} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <SectionHead
        id="faq-title"
        title="Common questions / Pertanyaan umum"
        meta="What clients ask before starting / Hal yang sering ditanyakan sebelum mulai."
      />
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question} / {faq.questionId}</summary>
            <BilingualCopy en={faq.answer} id={faq.answerId} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock id="services-contact-title" title="Ready to start? / Siap mulai? Tell me what you need / Ceritakan kebutuhanmu." />
</BaseLayout>
