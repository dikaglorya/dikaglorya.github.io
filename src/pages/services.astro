---
import ContactBlock from '../components/ContactBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs } from '../data/faqs';
import { processSteps } from '../data/facts';
import { services } from '../data/services';
import { site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Layanan ObitoGlory',
  url: `${site.url}/services/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: services.length,
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.name,
        description: service.description,
        provider: {
          '@id': `${site.url}/#person`,
        },
        areaServed: {
          '@type': 'Country',
          name: 'Indonesia',
        },
      },
    })),
  },
};
---

<BaseLayout
  title="Jasa Website, Bot, dan Tools di Kendal | DikaOfc (DikaGlorya)"
  description="Jasa pembuatan website, bot Telegram, tools custom, dan perbaikan sistem dari DikaGlorya (DikaOfc, DikaCode) di Kendal."
  schema={schema}
>
  <section class="page-hero page-hero--services" aria-labelledby="services-title">
    <div class="container">
      <p class="page-hero__eyebrow mono">Layanan · DikaOfc</p>
      <h1 id="services-title">Software praktis, dibuat dengan teliti.</h1>
      <p class="page-hero__lead">
        Pembuatan website, bot, tools, dan perbaikan sistem. Lingkup serta harga disepakati sebelum
        pekerjaan dimulai.
      </p>
      <div class="page-hero__meta mono">
        <span>{`${services.length} layanan`}</span>
        <span>{site.availability}</span>
        <span>{`Telegram @${site.telegram}`}</span>
      </div>
    </div>
  </section>

  <section class="section--tight" id="pricing" aria-label="Daftar layanan" data-reveal>
    <div class="container">
      {services.map((service, index) => (
        <section
          class="service-row"
          id={service.slug}
          aria-labelledby={`${service.slug}-title`}
        >
          <div class="service-row__index mono" aria-hidden="true">{`0${index + 1}`}</div>

          <div class="service-row__body">
            <h2 id={`${service.slug}-title`}>{service.name}</h2>
            <p class="service-row__lead">{service.description}</p>
            <div class="service-row__cols">
              <div>
                <h3 class="service-row__label mono">Hasil yang bisa dibuat</h3>
                <ul class="includes">
                  {service.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {service.platforms && (
                  <p class="mono muted service-row__platforms">
                    Platform: {service.platforms.join(', ')}
                  </p>
                )}
              </div>
              <div>
                <h3 class="service-row__label mono">Batasan lingkup</h3>
                <ul class="includes">
                  {service.limits.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="mono muted service-row__platforms">
                  Mulai {service.priceFrom} · {service.priceNote}
                </p>
              </div>
            </div>
            <a class="link" href={`/contact/?service=${service.slug}`}>
              Diskusikan layanan ini
            </a>
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section--tight" aria-labelledby="process-title" data-reveal>
    <div class="container">
      <SectionHead
        id="process-title"
        index="01 / Proses"
        title="Alur kerja"
        meta="Empat langkah jelas tanpa kejutan di tengah jalan."
      />
      <ol class="process-steps">
        {processSteps.map((step, index) => (
          <li>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight" id="faq" aria-labelledby="faq-title" data-reveal>
    <div class="container">
      <SectionHead
        id="faq-title"
        index="02 / FAQ"
        title="Pertanyaan umum"
        meta="Hal yang sering ditanyakan sebelum mulai."
      />
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock id="services-contact-title" title="Siap mulai? Ceritakan kebutuhanmu." />
</BaseLayout>
