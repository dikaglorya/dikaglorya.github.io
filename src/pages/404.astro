---
import PortraitFrame from '../components/PortraitFrame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman tidak ditemukan | ObitoGlory"
  description="Halaman ini tidak ditemukan."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title" data-reveal>
    <div class="container not-found__grid">
      <div class="not-found__body">
        <p class="not-found__code" aria-hidden="true">404</p>
        <h1 id="not-found-title">Halaman ini tidak ditemukan.</h1>
        <p>
          Mungkin halaman dipindahkan, tautannya salah, atau halamannya memang belum dibuat.
        </p>
        <div class="not-found__actions">
          <a class="btn btn--primary" href="/">Kembali ke beranda</a>
          <a class="btn" href="/projects/">Lihat proyek</a>
        </div>
      </div>
      <PortraitFrame
        class="not-found__portrait"
        sizes="(max-width: 900px) 240px, 280px"
        index="404"
      />
    </div>
  </section>
</BaseLayout>
