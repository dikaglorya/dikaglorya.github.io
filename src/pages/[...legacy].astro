---
import { site } from '../data/site';

export function getStaticPaths() {
  const redirects = [
    { legacy: 'proyek', target: '/projects/', label: 'Proyek' },
    { legacy: 'tentang', target: '/about/', label: 'Tentang' },
    { legacy: 'layanan', target: '/services/', label: 'Layanan' },
    { legacy: 'layanan/website', target: '/services/#website', label: 'Layanan website' },
    { legacy: 'layanan/bot', target: '/services/#bot', label: 'Layanan bot' },
    { legacy: 'layanan/tools', target: '/services/#tools', label: 'Layanan tools' },
    { legacy: 'layanan/perbaikan', target: '/services/#repairs', label: 'Layanan perbaikan' },
    { legacy: 'harga', target: '/services/#pricing', label: 'Harga' },
    { legacy: 'kontak', target: '/contact/', label: 'Kontak' },
    { legacy: 'faq', target: '/services/#faq', label: 'FAQ' },
  ];

  return redirects.map(({ legacy, target, label }) => ({
    params: { legacy },
    props: { target, label },
  }));
}

interface Props {
  target: string;
  label: string;
}

const { target, label } = Astro.props;
const targetURL = new URL(target, site.url).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={targetURL} />
    <title>Dipindahkan ke {label} | ObitoGlory</title>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        display: grid;
        min-height: 100svh;
        margin: 0;
        place-items: center;
        background: #ffffff;
        color: #171717;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      main {
        max-width: 36rem;
        padding: 2rem;
        line-height: 1.6;
      }
      a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #111111;
          color: #f5f5f5;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p>Halaman lama ini sudah dipindahkan ke <a href={target}>{label}</a>.</p>
    </main>
  </body>
</html>
