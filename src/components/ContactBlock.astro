---
import { site } from '../data/site';
import BilingualCopy from './BilingualCopy.astro';

interface Props {
  title?: string;
  id?: string;
}

const {
  title = 'Have something worth building? / Ada ide yang ingin diwujudkan?',
  id = 'contact-heading',
} = Astro.props;
---

<section class="contact-block" aria-labelledby={id}>
  <div class="container contact-block__inner">
    <div class="contact-block__main">
      <h2 class="contact-block__title" id={id}>{title}</h2>
      <BilingualCopy
        en="For project inquiries, collaboration, or technical discussions."
        id="Untuk pertanyaan project, kolaborasi, atau diskusi teknis."
      />
      <a class="btn btn--primary" href="/contact/">Get in touch / Hubungi saya</a>
    </div>

    <div class="contact-block__details mono">
      <p>{site.availability} / {site.locationShort}</p>
      <p class="contact-block__links">
        <a href={site.telegramUrl} rel="me" data-outbound="telegram">Telegram @{site.telegram}</a>
        <a href={site.github} rel="me noopener noreferrer" target="_blank" data-outbound="github">GitHub @{site.githubHandle}</a>
      </p>
    </div>
  </div>
</section>
