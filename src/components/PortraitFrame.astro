---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

interface Props {
  class?: string;
  sizes?: string;
  caption?: string;
  index?: string;
  priority?: boolean;
}

const {
  class: className = '',
  sizes = '(max-width: 900px) 300px, 360px',
  caption = 'DikaGlorya, developer',
  index = 'Potret 01',
  priority = false,
} = Astro.props;
---

<figure class:list={['portrait-frame', className]}>
  <div class="portrait-frame__media">
    <Image
      src={portrait}
      alt="Potret DikaGlorya dengan wajah yang sengaja ditutup tanda tanya."
      widths={[320, 480, 640]}
      sizes={sizes}
      quality={82}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <figcaption class="portrait-frame__caption mono">
    <span>{caption}</span>
    <span>{index}</span>
  </figcaption>
</figure>
