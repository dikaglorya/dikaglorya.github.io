---
type GlyphKind = 'website' | 'bot' | 'tools' | 'repairs';

interface Props {
  kind?: GlyphKind;
  class?: string;
}

const { kind = 'website', class: className = '' } = Astro.props;
const id = `glyph-${kind}`;
---

<svg
  class:list={['service-glyph', className]}
  viewBox="0 0 240 240"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-chrome`} x1="55" y1="45" x2="185" y2="195" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f2eee4" />
      <stop offset="0.28" stop-color="#3b5bff" />
      <stop offset="0.58" stop-color="#15161b" />
      <stop offset="0.86" stop-color="#ff5a1f" />
      <stop offset="1" stop-color="#f2eee4" />
    </linearGradient>
    <linearGradient id={`${id}-face`} x1="70" y1="70" x2="170" y2="170" gradientUnits="userSpaceOnUse">
      <stop stop-color="#24262f" />
      <stop offset="1" stop-color="#0b0c10" />
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="0" cy="0" r="1" gradientTransform="translate(120 150) rotate(90) scale(70)">
      <stop stop-color="#ff5a1f" stop-opacity="0.24" />
      <stop offset="1" stop-color="#ff5a1f" stop-opacity="0" />
    </radialGradient>
    <filter id={`${id}-shadow`} x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="9" />
    </filter>
  </defs>

  <ellipse cx="120" cy="196" rx="62" ry="13" fill="#000" opacity="0.5" filter={`url(#${id}-shadow)`} />
  <ellipse cx="120" cy="160" rx="70" ry="42" fill={`url(#${id}-glow)`} />

  {kind === 'website' && (
    <g>
      <polygon points="58,78 120,46 188,82 126,114" fill={`url(#${id}-face)`} stroke="#f2eee4" stroke-opacity="0.28" />
      <polygon points="126,114 188,82 188,158 126,190" fill="#0b0c10" stroke="#f2eee4" stroke-opacity="0.18" />
      <polygon points="58,78 126,114 126,190 58,154" fill={`url(#${id}-chrome)`} opacity="0.92" />
      <polygon points="58,78 126,114 126,124 58,88" fill="#ff5a1f" />
      <path d="M72 112 112 134M72 128 104 146M72 144 96 158" stroke="#07080a" stroke-opacity="0.62" stroke-width="3" />
      <path d="M136 108 176 88M136 128 176 108M136 148 166 133" stroke="#f2eee4" stroke-opacity="0.3" stroke-width="2" />
      <circle cx="170" cy="70" r="4" fill="#ff5a1f" />
    </g>
  )}

  {kind === 'bot' && (
    <g>
      <line x1="120" y1="30" x2="120" y2="56" stroke="#f2eee4" stroke-opacity="0.45" stroke-width="2" />
      <circle cx="120" cy="27" r="5" fill="#ff5a1f" />
      <path d="M160 50c10 6 16 15 18 26M80 50c-10 6-16 15-18 26" stroke="#3b5bff" stroke-opacity="0.7" stroke-width="2" stroke-linecap="round" />
      <polygon points="120,56 166,80 120,104 74,80" fill={`url(#${id}-face)`} stroke="#f2eee4" stroke-opacity="0.32" />
      <polygon points="74,80 120,104 120,154 74,130" fill={`url(#${id}-chrome)`} opacity="0.88" />
      <polygon points="120,104 166,80 166,130 120,154" fill="#0b0c10" stroke="#f2eee4" stroke-opacity="0.2" />
      <rect x="86" y="96" width="14" height="18" rx="2" fill="#07080a" />
      <rect x="104" y="105" width="14" height="18" rx="2" fill="#07080a" />
      <circle cx="93" cy="105" r="2.6" fill="#ff5a1f" />
      <circle cx="111" cy="114" r="2.6" fill="#ff5a1f" />
      <path d="M82 138 112 154M82 148 104 160" stroke="#07080a" stroke-opacity="0.55" stroke-width="2.5" />
      <path d="M136 112 156 102M136 126 156 116M136 140 150 132" stroke="#f2eee4" stroke-opacity="0.28" stroke-width="2" />
    </g>
  )}

  {kind === 'tools' && (
    <g>
      <g transform="rotate(-8 120 120)">
        <polygon points="92,72 132,52 172,72 132,92" fill={`url(#${id}-face)`} stroke="#f2eee4" stroke-opacity="0.3" />
        <polygon points="92,72 132,92 132,142 92,122" fill={`url(#${id}-chrome)`} opacity="0.9" />
        <polygon points="132,92 172,72 172,122 132,142" fill="#0b0c10" stroke="#f2eee4" stroke-opacity="0.2" />
        <path d="M100 88 124 100M100 104 124 116M100 120 116 128" stroke="#07080a" stroke-opacity="0.5" stroke-width="2.5" />
      </g>
      <g transform="translate(18 38) rotate(18 120 120)">
        <rect x="106" y="56" width="14" height="72" fill={`url(#${id}-chrome)`} />
        <path d="M106 128c0 12 8 20 18 20s18-8 18-20h-12c0 5-2 8-6 8s-6-3-6-8Z" fill="#ff5a1f" />
        <rect x="102" y="48" width="22" height="10" fill="#f2eee4" />
      </g>
      <circle cx="78" cy="164" r="5" fill="#3b5bff" />
      <circle cx="164" cy="160" r="4" fill="#ff5a1f" />
      <path d="M66 186h108" stroke="#f2eee4" stroke-opacity="0.2" stroke-dasharray="4 6" />
    </g>
  )}

  {kind === 'repairs' && (
    <g>
      <g transform="translate(-10 -4) rotate(-6 120 120)">
        <polygon points="52,74 112,44 120,108 60,138" fill={`url(#${id}-chrome)`} opacity="0.9" />
        <polygon points="52,74 60,138 58,150 50,86" fill="#0b0c10" />
        <path d="M70 92 100 78M74 108 104 94M78 124 108 110" stroke="#07080a" stroke-opacity="0.45" stroke-width="3" />
      </g>
      <g transform="translate(10 6) rotate(6 120 120)">
        <polygon points="130,44 190,74 182,138 122,108" fill={`url(#${id}-face)`} stroke="#f2eee4" stroke-opacity="0.3" />
        <polygon points="122,108 182,138 180,150 120,120" fill="#0b0c10" />
        <path d="M138 92 168 78M142 108 172 94M146 124 176 110" stroke="#f2eee4" stroke-opacity="0.25" stroke-width="2" />
      </g>
      <g transform="rotate(-14 120 120)">
        <rect x="102" y="80" width="36" height="72" fill="#ff5a1f" opacity="0.92" />
        <rect x="110" y="88" width="20" height="56" fill="#07080a" opacity="0.35" />
        <path d="M108 92h24M108 108h24M108 124h24M108 140h24" stroke="#f2eee4" stroke-opacity="0.55" stroke-width="2" />
      </g>
      <circle cx="120" cy="120" r="46" stroke="#ff5a1f" stroke-opacity="0.24" stroke-dasharray="3 8" />
    </g>
  )}
</svg>

<style>
  .service-glyph {
    display: block;
    overflow: visible;
    animation: glyph-float 7s ease-in-out infinite;
  }

  @keyframes glyph-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-glyph {
      animation: none;
    }
  }
</style>
