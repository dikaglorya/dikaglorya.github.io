---
interface Props {
  /** Title shown in the window bar. */
  title: string;
  /** Dimmed context after the title, e.g. a price. */
  note?: string;
  id?: string;
  /** Heading level inside the bar; `p` keeps the title non-content. */
  heading?: 'h2' | 'h3' | 'p';
  /** Allow dragging on desktop. */
  draggable?: boolean;
  /** Enable the yellow (minimize) light. */
  minimize?: boolean;
  /** Enable the green (fullscreen) light. */
  expand?: boolean;
  /** Remove body padding (for media/tables). */
  flush?: boolean;
  class?: string;
}

const {
  title,
  note,
  id,
  heading = 'h2',
  draggable = false,
  minimize = true,
  expand = false,
  flush = false,
  class: className = '',
} = Astro.props;
const Heading = heading;
---

<section
  class:list={['os-window', className]}
  id={id}
  data-window
  data-draggable={draggable ? '' : undefined}
  aria-label={title}
>
  <div class="os-window__bar" data-window-bar>
    <div class="os-window__lights" role="group" aria-label={`Kontrol jendela ${title}`}>
      <button
        class="os-light os-light--red"
        type="button"
        data-window-collapse
        aria-label={`Tutup jendela ${title}`}
      >
        <svg viewBox="0 0 6 6" aria-hidden="true"><path d="M1 1l4 4M5 1L1 5" /></svg>
      </button>
      {minimize && (
        <button
          class="os-light os-light--yellow"
          type="button"
          data-window-minimize
          aria-label={`Minimize jendela ${title}`}
        >
          <svg viewBox="0 0 6 6" aria-hidden="true"><path d="M1 3h4" /></svg>
        </button>
      )}
      {expand && (
        <button
          class="os-light os-light--green"
          type="button"
          data-window-fullscreen
          aria-expanded="false"
          aria-label={`Perbesar jendela ${title}`}
        >
          <svg viewBox="0 0 6 6" aria-hidden="true"><path d="M1 2V1h4v4H4" /></svg>
        </button>
      )}
    </div>
    <Heading class="os-window__title">
      <b>{title}</b>
      {note && <span aria-hidden="true"> · {note}</span>}
    </Heading>
  </div>
  {flush ? (
    <div class="os-window__body os-window__body--flush">
      <slot />
    </div>
  ) : (
    <div class="os-window__body">
      <slot />
    </div>
  )}
  <p class="os-window__collapsed" data-window-collapsed>
    <span><b>{title}</b> ditutup sementara.</span>
    <button class="link" type="button" data-window-uncollapse>Buka kembali</button>
  </p>
</section>
