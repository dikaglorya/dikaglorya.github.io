---
import Arrow from './Arrow.astro';

interface Props {
  title: string;
  id?: string;
  index?: string;
  meta?: string;
  link?: {
    href: string;
    label: string;
  };
}

const { title, id, index, meta, link } = Astro.props;
---

<div class="section-head">
  {index && <p class="section-head__index mono">{index}</p>}
  <h2 id={id}>{title}</h2>
  {(meta || link) && (
    <div class="section-head__meta">
      {meta && <p>{meta}</p>}
      {link && (
        <p>
          <a href={link.href} class="link">
            {link.label} <Arrow />
          </a>
        </p>
      )}
    </div>
  )}
</div>
