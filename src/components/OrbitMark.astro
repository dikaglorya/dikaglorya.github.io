---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 32 } = Astro.props;
---

<svg
  class:list={['orbit-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="orbit-chrome" x1="4" y1="8" x2="36" y2="32" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f2eee4" />
      <stop offset="0.42" stop-color="#3b5bff" />
      <stop offset="0.7" stop-color="#15161b" />
      <stop offset="1" stop-color="#ff5a1f" />
    </linearGradient>
    <radialGradient id="orbit-core" cx="0" cy="0" r="1" gradientTransform="translate(17 16) rotate(45) scale(12)">
      <stop stop-color="#f2eee4" />
      <stop offset="0.55" stop-color="#ff7a4a" />
      <stop offset="1" stop-color="#c93a0b" />
    </radialGradient>
  </defs>
  <ellipse cx="20" cy="20" rx="16.5" ry="7.2" transform="rotate(-28 20 20)" stroke="currentColor" stroke-width="1.2" opacity="0.55" />
  <ellipse cx="20" cy="20" rx="16.5" ry="7.2" transform="rotate(28 20 20)" stroke="url(#orbit-chrome)" stroke-width="2.2" />
  <circle cx="20" cy="20" r="6.2" fill="url(#orbit-core)" />
  <path d="M20 13.8a6.2 6.2 0 0 1 6.2 6.2c0 1.3-.4 2.5-1.1 3.5A6.2 6.2 0 0 0 20 13.8Z" fill="#07080a" opacity="0.45" />
  <circle cx="32.8" cy="11.4" r="1.6" fill="#ff5a1f" />
</svg>

<style>
  .orbit-mark {
    display: block;
    flex: none;
  }
</style>
