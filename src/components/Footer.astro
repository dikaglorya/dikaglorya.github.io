---
import { site, socialLinks } from '../data/site';
import { footerNavigation } from '../data/navigation';
import BilingualCopy from './BilingualCopy.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__wordmark" href="/">
          obitoglory<span class="dot">.</span>
        </a>
        <BilingualCopy
          class="footer__desc"
          en="DikaGlorya's work, published under the DikaCode developer identity. ObitoGlory is the canonical portfolio."
          id="Karya DikaGlorya diterbitkan dengan identitas developer DikaCode. ObitoGlory adalah portofolio resminya."
        />
      </div>

      <nav class="footer__nav" aria-label="Footer">
        {footerNavigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="footer__social">
        {socialLinks.map((link) => (
          <a href={link.href} rel={`noopener noreferrer ${link.rel}`} target="_blank" data-outbound={link.label.toLowerCase()}>
            {link.label}
          </a>
        ))}
        <a href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>

    <div class="footer__bottom mono">
      <p>© {year} ObitoGlory. DikaGlorya / DikaCode.</p>
      <p>Built with Astro. No analytics or tracking. / Dibuat dengan Astro, tanpa analytics atau tracking.</p>
      <p><a href="#top">Back to top / Kembali ke atas</a></p>
    </div>
  </div>
</footer>
