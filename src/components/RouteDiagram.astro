<div
  class="route-diagram"
  role="img"
  aria-label="Ilustrasi konseptual: satu request dari client masuk ke DikaRoute, lalu diteruskan ke provider yang tersedia dengan fallback otomatis."
>
  <div class="route-diagram__bar">
    <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="route-diagram__title">dikaroute — alur request</span>
    <span class="route-diagram__tag">Ilustrasi konseptual</span>
  </div>

  <div class="route-diagram__flow">
    <div class="route-diagram__node route-diagram__client">
      <span class="route-diagram__index mono">01 <span>REQUEST</span></span>
      <strong>Client</strong>
      <span>Satu request masuk</span>
    </div>

    <div class="route-diagram__connector" aria-hidden="true">
      <span class="route-diagram__connector-line"></span>
      <span class="route-diagram__connector-label mono">API</span>
    </div>

    <div class="route-diagram__node route-diagram__gateway">
      <span class="route-diagram__index mono">02 <span>GATEWAY</span></span>
      <strong>DikaRoute</strong>
      <span>API kompatibel OpenAI</span>
      <span class="route-diagram__gateway-foot mono">PILIH PROVIDER · COBA LAGI</span>
    </div>

    <div class="route-diagram__connector route-diagram__connector--branch" aria-hidden="true">
      <span class="route-diagram__connector-line"></span>
      <span class="route-diagram__connector-label mono">ROUTE</span>
    </div>

    <div class="route-diagram__providers">
      <div class="route-diagram__providers-heading">
        <span class="mono">PROVIDER</span>
        <span class="route-diagram__provider-count mono">01—03</span>
      </div>
      <div class="route-diagram__provider">
        <span class="route-diagram__provider-mark mono" aria-hidden="true">A</span>
        <span class="route-diagram__provider-copy">
          <strong>Provider A</strong>
          <small>Prioritas utama</small>
        </span>
        <span class="route-diagram__state mono">01</span>
      </div>
      <div class="route-diagram__provider">
        <span class="route-diagram__provider-mark mono" aria-hidden="true">B</span>
        <span class="route-diagram__provider-copy">
          <strong>Provider B</strong>
          <small>Alternatif tersedia</small>
        </span>
        <span class="route-diagram__state mono">02</span>
      </div>
      <div class="route-diagram__provider route-diagram__provider--fallback">
        <span class="route-diagram__provider-mark mono" aria-hidden="true">C</span>
        <span class="route-diagram__provider-copy">
          <strong>Provider C</strong>
          <small>Fallback otomatis</small>
        </span>
        <span class="route-diagram__state mono">NEXT</span>
      </div>
    </div>
  </div>
</div>
