---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={`route-diagram route-diagram--desktop ${className}`}
  viewBox="0 0 640 360"
  role="img"
  aria-labelledby="route-diagram-title route-diagram-desc"
>
  <title id="route-diagram-title">DikaRoute routing diagram</title>
  <desc id="route-diagram-desc">
    One client request enters DikaRoute. DikaRoute routes it to one of three providers. A dashed
    fallback path shows an automatic switch when a provider is unavailable.
  </desc>
  <defs>
    <marker id="route-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path class="route-diagram__arrow" d="M0 0 8 4 0 8Z" />
    </marker>
    <marker id="route-arrow-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path class="route-diagram__arrow route-diagram__arrow--accent" d="M0 0 8 4 0 8Z" />
    </marker>
  </defs>

  <rect class="route-diagram__node" x="16" y="150" width="112" height="60" />
  <text class="route-diagram__text" x="72" y="176" text-anchor="middle">CLIENT</text>
  <text class="route-diagram__small" x="72" y="193" text-anchor="middle">one request</text>

  <path class="route-diagram__line" d="M128 180H196" marker-end="url(#route-arrow)" />

  <rect class="route-diagram__core" x="208" y="120" width="176" height="120" />
  <text class="route-diagram__text--accent" x="296" y="164" text-anchor="middle">DIKAROUTE</text>
  <text class="route-diagram__small" x="296" y="184" text-anchor="middle">OpenAI-compatible</text>
  <text class="route-diagram__small" x="296" y="201" text-anchor="middle">routing + fallback</text>

  <path class="route-diagram__line" d="M384 180H452" marker-end="url(#route-arrow)" />
  <path class="route-diagram__line--accent" d="M384 180C430 180 430 280 452 280" stroke-dasharray="5 5" marker-end="url(#route-arrow-accent)" />
  <path class="route-diagram__line" d="M384 180C430 180 430 72 452 72" marker-end="url(#route-arrow)" />

  <rect class="route-diagram__node" x="452" y="44" width="160" height="56" />
  <text class="route-diagram__text" x="532" y="68" text-anchor="middle">PROVIDER A</text>
  <text class="route-diagram__small" x="532" y="85" text-anchor="middle">available</text>

  <rect class="route-diagram__node" x="452" y="152" width="160" height="56" />
  <text class="route-diagram__text" x="532" y="176" text-anchor="middle">PROVIDER B</text>
  <text class="route-diagram__small" x="532" y="193" text-anchor="middle">available</text>

  <rect class="route-diagram__node" x="452" y="252" width="160" height="56" />
  <text class="route-diagram__text" x="532" y="276" text-anchor="middle">PROVIDER C</text>
  <text class="route-diagram__small" x="532" y="293" text-anchor="middle">fallback</text>

  <text class="route-diagram__label" x="404" y="236">AUTO-FALLBACK</text>
</svg>

<svg
  class={`route-diagram route-diagram--mobile ${className}`}
  viewBox="0 0 360 320"
  role="img"
  aria-labelledby="route-diagram-mobile-title route-diagram-mobile-desc"
>
  <title id="route-diagram-mobile-title">DikaRoute routing diagram</title>
  <desc id="route-diagram-mobile-desc">
    One client request enters DikaRoute. DikaRoute routes it to provider A or provider B. A dashed
    accent path shows automatic fallback to provider C when a provider is unavailable.
  </desc>
  <defs>
    <marker id="route-arrow-mobile" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path class="route-diagram__arrow" d="M0 0 8 4 0 8Z" />
    </marker>
    <marker id="route-arrow-mobile-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path class="route-diagram__arrow route-diagram__arrow--accent" d="M0 0 8 4 0 8Z" />
    </marker>
  </defs>

  <rect class="route-diagram__node" x="110" y="12" width="140" height="48" />
  <text class="route-diagram__text" x="180" y="34" text-anchor="middle">CLIENT</text>
  <text class="route-diagram__small" x="180" y="50" text-anchor="middle">one request</text>

  <path class="route-diagram__line" d="M180 60V96" marker-end="url(#route-arrow-mobile)" />

  <rect class="route-diagram__core" x="60" y="96" width="240" height="76" />
  <text class="route-diagram__text--accent" x="180" y="124" text-anchor="middle">DIKAROUTE</text>
  <text class="route-diagram__small" x="180" y="142" text-anchor="middle">OpenAI-compatible</text>
  <text class="route-diagram__small" x="180" y="158" text-anchor="middle">routing + fallback</text>

  <path class="route-diagram__line" d="M180 172V190H64V240" marker-end="url(#route-arrow-mobile)" />
  <path class="route-diagram__line" d="M180 172V240" marker-end="url(#route-arrow-mobile)" />
  <path class="route-diagram__line--accent" d="M180 172V190H296V240" stroke-dasharray="5 5" marker-end="url(#route-arrow-mobile-accent)" />
  <text class="route-diagram__label" x="234" y="212" text-anchor="middle">AUTO-FALLBACK</text>

  <rect class="route-diagram__node" x="10" y="240" width="108" height="56" />
  <text class="route-diagram__text" x="64" y="264" text-anchor="middle">PROVIDER A</text>
  <text class="route-diagram__small" x="64" y="281" text-anchor="middle">available</text>

  <rect class="route-diagram__node" x="126" y="240" width="108" height="56" />
  <text class="route-diagram__text" x="180" y="264" text-anchor="middle">PROVIDER B</text>
  <text class="route-diagram__small" x="180" y="281" text-anchor="middle">available</text>

  <rect class="route-diagram__node" x="242" y="240" width="108" height="56" />
  <text class="route-diagram__text" x="296" y="264" text-anchor="middle">PROVIDER C</text>
  <text class="route-diagram__small" x="296" y="281" text-anchor="middle">fallback</text>
</svg>
