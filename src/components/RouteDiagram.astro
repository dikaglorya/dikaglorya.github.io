<div
  class="route-diagram"
  role="img"
  aria-label="DikaRoute menerima satu request dari client lalu meneruskannya ke provider AI yang tersedia, dengan fallback otomatis jika provider gagal."
>
  <div class="route-diagram__node route-diagram__client">
    <span class="route-diagram__index mono">01 · REQUEST</span>
    <strong>Client</strong>
    <span>Satu request</span>
  </div>

  <div class="route-diagram__connector" aria-hidden="true">
    <span></span>
    <span class="route-diagram__connector-label">ROUTE</span>
  </div>

  <div class="route-diagram__node route-diagram__gateway">
    <span class="route-diagram__index mono">02 · GATEWAY</span>
    <strong>DikaRoute</strong>
    <span>API kompatibel OpenAI</span>
  </div>

  <div class="route-diagram__connector route-diagram__connector--branch" aria-hidden="true">
    <span></span>
    <span class="route-diagram__connector-label">PILIH · ULANGI</span>
  </div>

  <div class="route-diagram__providers">
    <p class="route-diagram__providers-heading mono">PROVIDER TERSEDIA</p>
    <div class="route-diagram__provider">
      <span class="route-diagram__provider-mark" aria-hidden="true">A</span>
      <span><strong>Provider A</strong><small>Tersedia</small></span>
      <span class="route-diagram__state mono">SIAP</span>
    </div>
    <div class="route-diagram__provider">
      <span class="route-diagram__provider-mark" aria-hidden="true">B</span>
      <span><strong>Provider B</strong><small>Tersedia</small></span>
      <span class="route-diagram__state mono">SIAP</span>
    </div>
    <div class="route-diagram__provider route-diagram__provider--fallback">
      <span class="route-diagram__provider-mark" aria-hidden="true">C</span>
      <span><strong>Provider C</strong><small>Fallback otomatis</small></span>
      <span class="route-diagram__state mono">BERIKUTNYA</span>
    </div>
  </div>
</div>
