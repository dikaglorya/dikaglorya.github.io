---
import OrbitMark from './OrbitMark.astro';
import { mainNavigation } from '../data/navigation';
import { articles } from '../data/articles';
import { projects } from '../data/projects';
import { site, socialLinks } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const searchItems = [
  ...mainNavigation,
  { href: '/kendal/', label: 'Jasa website Kendal' },
  { href: '/contact/', label: 'Kontak' },
  ...projects.map((project) => ({ href: `/projects/${project.slug}/`, label: project.name })),
  ...articles.map((article) => ({ href: `/journal/${article.slug}/`, label: article.title })),
  ...socialLinks.map((link) => ({ href: link.href, label: `${link.label} ${link.handle}` })),
  { href: `mailto:${site.email}`, label: site.email },
];
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/">
      <OrbitMark class="brand__mark" />
      <span class="brand__stack">
        <span class="brand__name">obitoglory<span class="brand__dot">.</span></span>
        <span class="brand__by">DikaGlorya · Kendal</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Navigasi utama">
      {mainNavigation.map((item, index) => (
        <a
          class="site-nav__link"
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >
          <span class="site-nav__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <span class="header-time mono" data-clock>Kendal · --:-- WIB</span>
      <button
        class="icon-btn theme-btn"
        type="button"
        data-theme-toggle
        aria-label="Aktifkan tema terang"
        title="Ganti tema"
      >
        <svg class="theme-btn__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.6"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
        </svg>
        <svg class="theme-btn__moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8.2 8.2 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <button class="icon-btn" type="button" data-spotlight-open title="Cari (Ctrl K)">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="10.8" cy="10.8" r="6.3"></circle><path d="m15.5 15.5 4.2 4.2"></path></svg
        >
        <span class="sr-only">Cari halaman, proyek, dan tautan</span>
      </button>
      <a class="btn btn--primary btn--small header-cta" href="/contact/">Mulai proyek</a>
      <button
        class="menu-btn"
        type="button"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
        aria-expanded="false"
      >
        <span>Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
  <span class="scroll-progress" data-progress aria-hidden="true"></span>
</header>

<dialog class="spotlight" data-spotlight aria-labelledby="spotlight-title">
  <div class="spotlight__inner">
    <h2 class="sr-only" id="spotlight-title">Cari halaman, proyek, dan tautan</h2>
    <label class="spotlight__search">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><circle cx="10.8" cy="10.8" r="6.3"></circle><path d="m15.5 15.5 4.2 4.2"></path></svg
      >
      <input
        type="search"
        placeholder="Cari proyek, jurnal, halaman..."
        autocomplete="off"
        data-spotlight-input
      />
      <kbd>ESC</kbd>
    </label>
    <ul class="spotlight__results" data-spotlight-results>
      {searchItems.map((item) => (
        <li data-search-item data-search-label={item.label.toLowerCase()}>
          <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ul>
    <p class="spotlight__empty" data-spotlight-empty hidden>Tidak ada hasil.</p>
  </div>
</dialog>

<dialog class="mobile-menu" id="mobile-menu" data-menu aria-labelledby="mobile-menu-title">
  <div class="mobile-menu__inner">
    <div class="mobile-menu__bar">
      <a class="brand" href="/">
        <OrbitMark class="brand__mark" />
        <span class="brand__name">obitoglory<span class="brand__dot">.</span></span>
      </a>
      <h2 id="mobile-menu-title" class="sr-only">Menu</h2>
      <button class="mobile-menu__close" type="button" data-menu-close>
        Tutup
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
          ><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5"
          ></path></svg
        >
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Navigasi seluler">
      {mainNavigation.map((item, index) => (
        <a
          class="mobile-menu__link"
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >
          {item.label}
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </a>
      ))}
      <a class="mobile-menu__link" href="/kendal/">
        Kendal
        <span aria-hidden="true">06</span>
      </a>
    </nav>

    <div class="mobile-menu__foot">
      <p class="status">{site.availability}</p>
      <p class="mono mobile-menu__location">{site.location}</p>
      <button class="theme-row" type="button" data-theme-toggle aria-label="Tema: Gelap. Aktifkan tema terang">
        <span>Tema</span>
        <span class="theme-row__value" data-theme-label>Gelap</span>
      </button>
      <a class="btn btn--primary" href="/contact/">Mulai proyek</a>
      <div class="mobile-menu__socials">
        {socialLinks.map((link) => (
          <a href={link.href} rel={`noopener noreferrer ${link.rel}`} target="_blank">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</dialog>
