---
interface Props {
  en: string;
  id: string;
  class?: string;
}

const { en, id, class: className = '' } = Astro.props;
---

<span class:list={['bilingual-copy', className]}>
  <span class="bilingual-copy__line" lang="en">
    <span class="bilingual-copy__language" aria-hidden="true">EN</span>
    {en}
  </span>
  <span class="bilingual-copy__line bilingual-copy__line--id" lang="id">
    <span class="bilingual-copy__language" aria-hidden="true">ID</span>
    {id}
  </span>
</span>
