---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/motion.css';
import '../styles/depth.css';
import '../styles/glass.css';
import '../styles/controls.css';
import '../styles/explorer.css';

import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';

import CookieConsent from '../components/CookieConsent.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { services } from '../data/services';
import { site, socialLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  noindex = false,
  schema,
  bodyClass = '',
} = Astro.props;

const isFile = /\.[a-z0-9]+$/i.test(Astro.url.pathname);
const canonicalPath =
  isFile || Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const imageURL = new URL(image, Astro.site);
const ogImageAlt = site.ogImageAlt;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.personName,
  alternateName: site.alternateNames,
  url: site.url,
  image: new URL(site.profileImage, Astro.site).href,
  jobTitle: 'Developer independen',
  description: site.description,
  email: `mailto:${site.email}`,
  knowsLanguage: ['id', 'en'],
  nationality: { '@type': 'Country', name: 'Indonesia' },
  homeLocation: {
    '@type': 'Place',
    name: 'Kendal, Jawa Tengah',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Jawa Tengah',
      addressCountry: 'ID',
    },
  },
  workLocation: {
    '@type': 'Place',
    name: 'Kendal, Jawa Tengah',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kendal',
      addressRegion: 'Jawa Tengah',
      addressCountry: 'ID',
    },
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kendal',
    addressRegion: 'Jawa Tengah',
    addressCountry: 'ID',
  },
  knowsAbout: [
    'Pengembangan web',
    'Astro',
    'Bot Telegram',
    'Gateway AI',
    'Automasi keamanan',
    'Pengembangan Android',
    'Termux',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Developer independen',
    occupationLocation: {
      '@type': 'City',
      name: 'Kendal',
    },
    skills: 'Web development, Telegram bots, AI gateways, developer tools, automation',
  },
  sameAs: socialLinks.map((link) => link.href),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'id',
  publisher: { '@id': `${site.url}/#person` },
  author: { '@id': `${site.url}/#person` },
};

const studioSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#studio`,
  name: site.name,
  alternateName: ['DikaCode', 'DikaOfc', 'DikaGlorya'],
  url: site.url,
  image: imageURL.href,
  description:
    'Layanan pembuatan website, bot, tools custom, dan perbaikan sistem oleh DikaGlorya di Kendal, Jawa Tengah.',
  founder: { '@id': `${site.url}/#person` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kendal',
    addressRegion: 'Jawa Tengah',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -6.921,
    longitude: 110.202,
  },
  areaServed: [
    { '@type': 'City', name: 'Kendal' },
    { '@type': 'City', name: 'Semarang' },
    { '@type': 'City', name: 'Batang' },
    { '@type': 'City', name: 'Pekalongan' },
    { '@type': 'AdministrativeArea', name: 'Jawa Tengah' },
    { '@type': 'Country', name: 'Indonesia' },
  ],
  priceRange: 'Rp50.000 - Rp3.000.000+',
  sameAs: socialLinks.map((link) => link.href),
  makesOffer: services.map((service) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: service.name,
      description: service.description,
      provider: { '@id': `${site.url}/#studio` },
    },
    priceSpecification: {
      '@type': 'PriceSpecification',
      priceCurrency: 'IDR',
      description: `${service.priceFrom}. ${service.priceNote}`,
    },
  })),
};

const pageSchemas = [
  personSchema,
  websiteSchema,
  studioSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07080a" data-theme-color />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let choice = null;
        try {
          choice = localStorage.getItem('theme');
        } catch {
          choice = null;
        }
        if (choice !== 'light' && choice !== 'dark') {
          choice = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        root.dataset.theme = choice;
        const meta = document.querySelector('meta[data-theme-color]');
        if (meta) meta.setAttribute('content', choice === 'light' ? '#f2eee4' : '#07080a');
      })();
    </script>
    <meta name="author" content={site.personName} />
    <meta
      name="keywords"
      content="DikaGlorya, DikaOfc, DikaCode, developer Kendal, jasa website Kendal, pembuatan website Kendal, bot Telegram, developer tools, ObitoGlory"
    />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="geo.region" content="ID-JT" />
    <meta name="geo.placename" content="Kendal, Jawa Tengah" />
    <meta name="geo.position" content="-6.921;110.202" />
    <meta name="ICBM" content="-6.921, 110.202" />

    <link rel="preload" as="font" type="font/woff2" href={interFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderFont} crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      window.setTimeout(() => {
        if (document.documentElement.dataset.motion !== 'ready') {
          document.documentElement.classList.remove('js');
        }
      }, 4000);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Jurnal ObitoGlory" href="/rss.xml" />
    <link rel="author" href={`${site.url}/about/`} />
    {socialLinks.map((link) => <link rel="me" href={link.href} />)}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {pageSchemas.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <slot name="head" />
  </head>
  <body id="top" class={bodyClass}>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <div class="intro-layer" data-cinematic-intro role="dialog" aria-modal="true" aria-labelledby="intro-title" aria-hidden="true" hidden>
      <div class="intro-layer__inner">
        <p class="intro-layer__kicker">INDEPENDENT DEVELOPER · KENDAL, ID</p>
        <p class="intro-layer__title" id="intro-title"><span>DIKA</span> <em>GLORYA</em></p>
        <span class="intro-layer__rule"></span>
      </div>
      <button class="intro-layer__skip" type="button" data-intro-skip>Lewati intro <kbd>↵</kbd></button>
    </div>
    <div class="cursor" data-cursor aria-hidden="true"></div>
    <script>
      import { initCinematicIntro } from '../scripts/cinematic';
      import '../scripts/ui';
      initCinematicIntro();
      if (document.body.classList.contains('home')) {
        const loadCinematicMotion = () => void import('../scripts/motion');
        const idleWindow = window as Window & { requestIdleCallback?: (callback: IdleRequestCallback, options?: IdleRequestOptions) => number };
        if (idleWindow.requestIdleCallback) idleWindow.requestIdleCallback(loadCinematicMotion, { timeout: 900 });
        else window.setTimeout(loadCinematicMotion, 250);
      } else {
        void import('../scripts/motion-lite');
      }
    </script>
  </body>
</html>
